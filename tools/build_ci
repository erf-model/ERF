#!/bin/bash
#
# WDM6 build and validation script with group-specific CI support
# Usage: ./build_ci [GROUP] [OPTIONS]
#
# Options:
#   --no-build                 Skip the build, validate against a fresh run
#   --all-tags                 Run once, report all canonical groups
#   --target-column "I J"      Diagnostic column (default "100 0")
#   --max-step N               Steps to advance (default 1)
#   --jobs N                   Build parallelism (default 1; the box is RAM-bound)
#
# Example:
#   ./build_ci G7                                  # build and validate G7
#   ./build_ci G7 --no-build                       # validate G7 only
#   ./build_ci G13e --target-column "199 3" --max-step 2
#   ./build_ci --all-tags --no-build
#
# Notes:
#   - No mpirun. bubble_campaign.md requires it for this campaign and build_wdm6
#     is configured ERF_ENABLE_MPI=OFF.
#   - Marker comparison is per-k. Tags emitting a full kts..kte column are
#     matched level by level and reduced over the column, reporting the k at
#     which the maximum occurs. A tag emitting one cell still works and simply
#     reports a single level.
#   - tools/ is untracked, so results from this harness are triage-only.
#

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ERF_ROOT="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$ERF_ROOT/build_wdm6"
BUBBLE_DIR="$ERF_ROOT/Exec/RegTests/Bubble"

# Default group to validate
GROUP="${1:-G7}"
SKIP_BUILD=false
ALL_TAGS=false
TARGET_COLUMN="100 0"
MAX_STEP=1
BUILD_JOBS=1
WDM6_GROUPS=(
    P0 G1a G1b G1c G2 G3 G4 G5a G5b G5c G6 G7 G8 G9
    G10a G10b G10c G10d G10e G11 G12
    G13a G13b G13c G13d G13e G13f G13g
    G14 G15 G16a G16b G17
)

canonicalize_group_tag() {
    local group_name=$1
    if [[ "$group_name" =~ ^G([0-9]+)([a-z])$ ]]; then
        printf "G%s%s" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]^^}"
    else
        printf "%s" "$group_name"
    fi
}

# Parse remaining arguments
shift || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-build)       SKIP_BUILD=true ;;
        --all-tags)       ALL_TAGS=true ;;
        --target-column)  TARGET_COLUMN="$2"; shift ;;
        --max-step)       MAX_STEP="$2"; shift ;;
        --jobs)           BUILD_JOBS="$2"; shift ;;
        *) echo "WARNING: unrecognized argument '$1'" ;;
    esac
    shift
done

case "$GROUP" in
    --no-build)  SKIP_BUILD=true; GROUP="G7" ;;
    --all-tags)  ALL_TAGS=true;   GROUP="G7" ;;
    --*)         GROUP="G7" ;;
esac

# A run label that keeps artifacts from different columns/steps apart
RUN_SUFFIX="c$(echo "$TARGET_COLUMN" | tr -d ' ')_s${MAX_STEP}"

# ============================================================
# Helper function: run one WDM6 bridge/native pair
# ============================================================
run_wdm6_pair() {
    local RUN_LABEL=$1
    if [[ ! -d "$BUBBLE_DIR" ]]; then
        echo "ERROR: Bubble directory not found: $BUBBLE_DIR"
        return 1
    fi

    cd "$BUBBLE_DIR"

    echo "   target column: ($TARGET_COLUMN)   max_step: $MAX_STEP"

    echo "[1/4] Running Fortran bridge validation..."
    local fort_log="wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_fortran.log"
    # Don't fail on non-zero exit; we want the prints even if the run dies later
    "$BUILD_DIR/Exec/erf_exec" inputs_BF02_moist_bubble \
        erf.moisture_model=WDM6 \
        erf.use_wdm6_cpp_answer=0 \
        erf.microphysics_debug=1 \
        erf.micro_diag_target_column="$TARGET_COLUMN" \
        max_step="$MAX_STEP" \
        erf.plot_file_1="plt_wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_fortran" \
        erf.check_file="chk_wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_fortran" \
        > "$fort_log" 2>&1 || true
    echo "   ✓ Fortran bridge run logged: $fort_log"

    echo "[2/4] Running C++ implementation validation..."
    local cpp_log="wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_cpp.log"
    "$BUILD_DIR/Exec/erf_exec" inputs_BF02_moist_bubble \
        erf.moisture_model=WDM6 \
        erf.use_wdm6_cpp_answer=1 \
        erf.microphysics_debug=1 \
        erf.micro_diag_target_column="$TARGET_COLUMN" \
        max_step="$MAX_STEP" \
        erf.plot_file_1="plt_wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_cpp" \
        erf.check_file="chk_wdm6_bubble_${RUN_LABEL}_${RUN_SUFFIX}_cpp" \
        > "$cpp_log" 2>&1 || true
    echo "   ✓ C++ implementation run logged: $cpp_log"

    FORT_LOG_PATH="$fort_log"
    CPP_LOG_PATH="$cpp_log"
    export FORT_LOG_PATH CPP_LOG_PATH

    return 0
}

# ============================================================
# Helper function: extract one group's markers from existing logs
# ============================================================
extract_group_markers() {
    local GROUP=$1
    local fort_log=$2
    local cpp_log=$3
    local TAG_GROUP
    TAG_GROUP=$(canonicalize_group_tag "$GROUP")

    echo ""
    echo "=========================================="
    echo "WDM6 Group Validation: $GROUP"
    echo "=========================================="

    # Counts, not head -1: a single-cell tag and a full-column tag must be
    # distinguishable at a glance.
    echo "[3/4] Fortran marker inventory for $GROUP..."
    local nfp=$(grep -c "WDM6-FORT_PRE_${TAG_GROUP} " "$fort_log" || true)
    local nfq=$(grep -c "WDM6-FORT_POST_${TAG_GROUP} " "$fort_log" || true)
    echo "   FORT_PRE lines:  $nfp"
    echo "   FORT_POST lines: $nfq"
    if [[ "$nfp" == "0" && "$nfq" == "0" ]]; then
        echo "   WARNING: no WDM6-FORT_*_${TAG_GROUP} markers found"
        grep "WDM6-FORT" "$fort_log" | tail -3 || echo "   (no Fortran markers at all)"
    fi

    echo "[4/4] C++ marker inventory for $GROUP..."
    local ncp=$(grep -c "WDM6-CPP_PRE_${TAG_GROUP} " "$cpp_log" || true)
    local ncq=$(grep -c "WDM6-CPP_POST_${TAG_GROUP} " "$cpp_log" || true)
    echo "   CPP_PRE lines:   $ncp"
    echo "   CPP_POST lines:  $ncq"
    if [[ "$ncp" == "0" && "$ncq" == "0" ]]; then
        echo "   WARNING: no WDM6-CPP_*_${TAG_GROUP} markers found"
        grep "WDM6-CPP" "$cpp_log" | tail -3 || echo "   (no C++ markers at all)"
    fi

    python3 - "$fort_log" "$cpp_log" "$GROUP" "$TAG_GROUP" <<'PY'
import re, sys

fort_log, cpp_log, grp, tag_grp = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
pairs = [("PRE",  "WDM6-FORT_PRE_"  + tag_grp, "WDM6-CPP_PRE_"  + tag_grp),
         ("POST", "WDM6-FORT_POST_" + tag_grp, "WDM6-CPP_POST_" + tag_grp)]

num_re = re.compile(r'[-+]?\d*\.?\d+(?:[EeDd][-+]?\d+)?')

def payload_nums(line, tag):
    """Numbers after the tag token. First is the k index, rest are the fields."""
    idx = line.find(tag)
    rest = line[idx + len(tag):]
    out = []
    for tok in num_re.findall(rest):
        try:
            out.append(float(tok.replace('D', 'E').replace('d', 'e')))
        except ValueError:
            pass
    return out

def collect(path, tag, which):
    """Map k -> field list.

    A loop-guarded tag emits one block of kts..kte per timestep, so with
    max_step>1 the same k appears once per step. which='first' keeps the
    earliest occurrence (step 1) and which='last' keeps the most recent
    (final step). Comparing the two shows growth across steps, which is the
    whole point when a defect only appears after step 1.

    For a tag with no loop guard the same distinction separates the first
    minor-loop pass from the last.
    """
    by_k = {}
    with open(path, "r", errors="ignore") as f:
        for ln in f:
            if tag not in ln:
                continue
            vals = payload_nums(ln, tag)
            if not vals:
                continue
            k = int(vals[0])
            if which == "last" or k not in by_k:
                by_k[k] = vals[1:]
    return by_k

def count_blocks(path, tag):
    """How many times the kts..kte block repeats, i.e. steps x minor loops."""
    n, seen = 0, set()
    with open(path, "r", errors="ignore") as fh:
        for ln in fh:
            if tag not in ln:
                continue
            v = payload_nums(ln, tag)
            if not v:
                continue
            k = int(v[0])
            if k in seen:
                n += 1
                seen = set()
            seen.add(k)
    return n + 1 if seen else n

print(f"=== Marker numeric diff: {grp} ===")
for kind0, ftag, ctag in pairs:
  nblocks = count_blocks(fort_log, ftag)
  # Only split first/last when the block actually repeats; otherwise they are
  # the same data and printing twice is noise.
  passes = ("first", "last") if nblocks > 1 else ("first",)
  for which in passes:
    kind = f"{kind0}[{which}of{nblocks}]" if nblocks > 1 else kind0
    F = collect(fort_log, ftag, which)
    C = collect(cpp_log, ctag, which)
    if not F or not C:
        missing = " ".join(x for x, empty in (("FORT", not F), ("CPP", not C)) if empty)
        print(f"{kind}: MISSING ({missing})")
        continue

    shared = sorted(set(F) & set(C))
    if not shared:
        print(f"{kind}: NO SHARED k  (fort k={sorted(F)[:4]}..., cpp k={sorted(C)[:4]}...)")
        continue

    worst = (-1.0, None, None)          # (diff, k, field index)
    nfields = None
    per_k_max = {}
    for k in shared:
        fn, cn = F[k], C[k]
        n = min(len(fn), len(cn))
        nfields = n if nfields is None else min(nfields, n)
        kmax = 0.0
        for i in range(n):
            d = abs(fn[i] - cn[i])
            if d > kmax:
                kmax = d
            if d > worst[0]:
                worst = (d, k, i)
        per_k_max[k] = kmax

    only_f = sorted(set(F) - set(C))
    only_c = sorted(set(C) - set(F))
    print(f"{kind}: levels={len(shared)} fields={nfields} "
          f"max_abs_diff={worst[0]:.3e} at k={worst[1]} field={worst[2]}")
    if only_f or only_c:
        print(f"  WARNING unmatched k: fort-only={only_f[:6]} cpp-only={only_c[:6]}")

    nz = [(k, v) for k, v in per_k_max.items() if v > 0.0]
    if not nz:
        print("  all levels bitwise equal")
    else:
        nz.sort(key=lambda kv: -kv[1])
        head = " ".join(f"k{k}={v:.3e}" for k, v in nz[:8])
        print(f"  nonzero levels={len(nz)}/{len(shared)}  worst: {head}")
        # per-field profile at the worst level
        k = worst[1]
        fn, cn = F[k], C[k]
        prof = " ".join(f"{abs(fn[i]-cn[i]):.2e}" for i in range(min(len(fn), len(cn))))
        print(f"  per-field abs diff at k={k}: {prof}")
PY
    echo ""
    echo "✓ Marker extraction complete for $GROUP"
    echo "   Fortran log: $fort_log"
    echo "   C++ log:     $cpp_log"
    echo ""
    echo "To view full markers:"
    echo "   grep 'WDM6-FORT_PRE_${TAG_GROUP} \|WDM6-FORT_POST_${TAG_GROUP} ' $fort_log"
    echo "   grep 'WDM6-CPP_PRE_${TAG_GROUP} \|WDM6-CPP_POST_${TAG_GROUP} ' $cpp_log"

    return 0
}

# ============================================================
# Main
# ============================================================

if [[ "$SKIP_BUILD" != "true" ]]; then
    echo "Building WDM6 (-j $BUILD_JOBS)..."
    cd "$BUILD_DIR"
    make -j "$BUILD_JOBS" || {
        echo "ERROR: Build failed"
        exit 1
    }
    echo "✓ Build successful"
fi

# Validate the requested group set
if [[ "$ALL_TAGS" == "true" ]]; then
    echo ""
    echo "=========================================="
    echo "WDM6 Shared Validation Run"
    echo "=========================================="
    run_wdm6_pair "all_tags" || exit $?
    for group_name in "${WDM6_GROUPS[@]}"; do
        extract_group_markers "$group_name" "$FORT_LOG_PATH" "$CPP_LOG_PATH" || exit $?
    done
else
    validate_run_label="$GROUP"
    echo ""
    echo "=========================================="
    echo "WDM6 Group Validation: $GROUP"
    echo "=========================================="
    run_wdm6_pair "$validate_run_label" || exit $?
    extract_group_markers "$GROUP" "$FORT_LOG_PATH" "$CPP_LOG_PATH"
fi

exit $?
