! ==================================================================================
! SMS-3DTKE CONFIGURATION
! ==================================================================================
! km_opt = 5           (SMS-3DTKE - scale-aware TKE-based LES closure)
! diff_opt = 2         (Full diffusion)
! sfs_opt = 2          (Subfilter-scale TKE option for SMS-3DTKE)
! bl_pbl_physics = 0   (No traditional PBL scheme - using LES-type closure)
!
! Key parameters (set in module_diffusion.F or via Registry):
! C_k = 0.1            (TKE production coefficient, matches erf.Ck)
! C_eps = 0.93         (Dissipation coefficient, matches erf.Ce)
! C_s = 0.18           (Smagorinsky constant, matches erf.sms3dtke.C_s)
! alpha_sgs = 0.25     (SGS fraction parameter, matches erf.sms3dtke.alpha_sgs)
! sigma_k = 0.5        (TKE diffusion coefficient, matches erf.sigma_k)
!
! Surface layer: sf_sfclay_physics = 1 (Revised MM5 scheme)
!   z0 = 0.16 m (set in met_em or wrfinput)
!   Surface heat flux = 0.24 K m/s (corresponds to tsk, hfx settings)
!
! Top boundary: spec_zone with θ gradient = 0.003 K/m
! ==================================================================================

! ==================================================================================
! MATCHING ERF SETUP:
! ==================================================================================
! Domain: 30 km × 30 km × 2 km (periodic lateral BCs)
! Resolution: 1 km horizontal, ~80 m vertical
! Initial condition: Zhang et al. (2018) sounding
!   - Mixed layer: θ = 300 K from surface to 925 m
!   - Inversion: linear increase 925-1075 m to 308.05 K
!   - Free atmosphere: θ = 308.05 + 0.003*(z-1075)
! Geostrophic wind: U_g = 10 m/s (set via cor, coriolis option)
! Coriolis: f = 5×10⁻⁵ s⁻¹ (corresponds to rotational_time_period = 125663.7 s)
! Surface heat flux: 0.24 K m/s
! Surface roughness: z0 = 0.16 m
! ==================================================================================
