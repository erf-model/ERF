# HaboobFirePit — Phase 5 integration: all Phase 1-4 physics in Gaussian pit.
#
# Open pit mine analog. Negative hill amplitude produces a concave pit 200 m
# deep. Fire ignites on the pit floor. Smoke and dust are trapped in the
# stable air pool at the pit bottom before being lofted by the fire convective
# column. This is the first ERF-Hazard open pit mine simulation.
#
# Expected results:
#   (1) z_phys_nd at domain centre < 0 (pit floor below datum)
#   (2) Smoke and dust concentrations elevated at pit floor (stable pool trapping)
#   (3) All Phase 1-4 [DUST DEBUG] and [FIRE DEBUG] signatures present
#   (4) fire_stats.csv: burned_area_ha > 0 and increasing
#   (5) No NaN in any field, run exits code 0 at max_step=20

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 4000.0 4000.0 1500.0
amr.n_cell = 32 32 64
geometry.is_periodic = 1 1 0
amrex.max_grid_size_z = 64
zlo.type = "surface_layer"
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.most.surf_temp_flux = 0.0
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int_1 = -1
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.transport_scalar = true

# Terrain
erf.terrain_type = StaticFittedMesh
