# ============================================================
# Test: FireDustWindStrength
# Description: Phase 2 sensitivity to fire intensity (fuel model).
#   Verifies that stronger fires (higher ROS, higher heat flux) generate
#   stronger fire_wind_eff, which drives higher u* via the log-law max.
#   Phase 1 disabled (crust_index=0, crust_reduction=0).
#
# This test uses FM4 (chaparral, high intensity).
# Compare with FireDustInteraction2 (FM1, standard intensity) at same conditions.
#
# Settings:
#   fuel_model_id = 4                -> FM4 chaparral (high ROS, high heat flux)
#   crust_index = 0.0                -> Phase 1 disabled
#   fire_dust_crust_reduction = 0.0  -> Phase 1 confirmed inactive
#   fire_dust_wind_to_dust = true    -> Phase 2 active
#   fire.coupling_type = "passive"   -> no fire heat injection
#   sounding_neutral_abl (u=15 m/s) -> consistent with geo_wind=15.0
#
# FM4 vs FM1 comparison at step=20 (15 m/s sounding, passive fire):
#
#   Metric                     | FM1 (Interaction2) | FM4 (WindStrength)  | Ratio
#   ---------------------------|--------------------|--------------------|-------
#   fire_wind_eff_max [m/s]    | 5.273              | 7.962              | 1.51x
#   Max ROS [m/s]              | 0.216              | 0.845              | 3.91x
#   Q_max [W/m^2]              | 3520               | 288713             | 82x
#   T_flame_max [K]            | 536                | 1305               | 2.4x
#   I_B_max [kW/m]             | 7.64               | 2490               | 326x
#   fire-derived u* [m/s]      | 0.513              | 0.775              | 1.51x
#   ustar_max_after [m/s]      | 1.121              | 1.121              | 1.0x
#   emission_sum [kg/s]        | 1.1888e-05         | 1.1888e-05         | ~1.0x
#
# Key finding: At 15 m/s background wind, MRF u*=1.121 m/s dominates over
# both FM1 fire-derived u*=0.513 m/s AND FM4 fire-derived u*=0.775 m/s.
# The Phase 2 max() correctly keeps MRF u* in both cases.
# FM4 fire IS significantly more intense (1.51x stronger fire wind,
# 82x higher heat flux) but cannot overcome the 15 m/s background at u*.
# To observe fuel model sensitivity in dust emission, use weak background
# wind (sounding_weak_wind_abl) where fire wind can dominate MRF u*.
#
# Expected Results (verified, FM4, step=20, t=10 s, sounding_neutral_abl):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s.
#   - u*_max = 1.121 m/s  |  u_10m_max = 14.994 m/s  |  PBLH = 534.7 m
#   - EddyDiff::Scalar_v_max = 2.168 m^2/s
#   - T_sfc_max = 300 K  (passive fire, no heating)
#
#   Fire FM4 (step 20):
#   - 32 active fire cells (ignition_r=600 m)
#   - Max reference wind = 14.562 m/s
#   - Max effective wind (post-WAF) = 7.962447894 m/s  (vs 5.273 for FM1)
#   - Max ROS = 0.8449813953 m/s  (vs 0.216 for FM1)
#   - Q_max = 288712.9 W/m^2  |  I_B_max = 2489.76 kW/m  |  L_max = 2.828 m
#   - T_flame_max = 1304.9 K  (vs 536.5 K for FM1)
#   - phi_min=-1  phi_max=0
#
#   Phase 2 output (step 20):
#   - [DUST DEBUG] Phase 2 fire-wind coupling:
#       fire_wind_max=7.962447894 m/s
#       ustar_max_after=1.12149862 m/s
#       C=1
#   - fire-derived u* = 7.962*0.4/ln(6.1/0.1) = 0.775 m/s < MRF 1.121 m/s
#   - max() correctly keeps MRF u*
#
#   Phase 1 output (step 20):
#   - crust_min=0, crust_max=0, reduction=0  (Phase 1 disabled)
#   - u*_t = 0.004741 m/s (USTAR_T_MIN floor)
#
#   Dust Emission (step 20):
#   - emission_sum = 1.188840e-05 kg/s  (identical to FM1 at 15 m/s)
#   - emission_flux bin0 max = 4.643905e-08 kg/m^2/s
#   - conc_sfc_max = 81.557 ug/m^3  |  PM10 = 77.382 ug/m^3
#   - RHO DUST = 11.924
#   - dep_total = 2.842e-07 kg/m^2
#
#   Performance:
#   - Timestep wall time ~ 5.6e-03 s  |  Total ~ 0.127 s
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
# sounding_neutral_abl: u=15 m/s, consistent with geo_wind=15.0
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
# geo_wind = 15.0 consistent with sounding_neutral_abl
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 0.0: fully bare soil; Phase 1 inactive
erf.dust.crust_index = 0.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors are neutral (1.0) since use_terrain_wind=false
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
# FM4 chaparral: higher ROS, higher heat flux than FM1 short grass
# Produces fire_wind_eff_max=7.962 m/s vs 5.273 m/s for FM1 (1.51x)
# Change to fuel_model_id = 1 to reproduce FireDustInteraction2 baseline
erf.fire.fuel_model_id = 4
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 600 m marks ~32 burned cells at t=0 (~12.5% of fire domain)
erf.fire.ignition_r = 600.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = false
# coupling_type = passive: fire heat NOT injected (isolates Phase 2 effect)
erf.fire.coupling_type = "passive"
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# Phase 1 disabled
erf.fire_dust_crust_reduction = 0.0
# Phase 2: fire outflow wind -> dust u* via log-law max
erf.fire_dust_wind_to_dust = true
erf.fire_dust_wind_z0 = 0.1
erf.fire_dust_wind_zref = 6.1
