# ============================================================
# Test: FireDustTerrainCoupled
# Description: Full coupling test combining fire spread, dust
#              emission, and terrain wind effects simultaneously.
#              Both fire and dust use terrain wind corrections.
#              Fire-dust coupling is active with crust reduction
#              in burned zones. Lagged fire-wind coupling.
#
# Grid ratios: dust.grid_ratio = fire.grid_ratio = 2
#   REQUIRED: must match when fire_dust_coupling=true.
#   ignition_r = 600 m marks ~32 burned fire cells at t=0
#   (~12.5% of 16x16 fire domain), consistent with FireDustInteraction1.
#
# Expected Results:
#
# --- Step 20 (t=10 s, verified) ---
#
#   Dynamics:
#   - u*_max ~ 0.771 m/s  |  u_10m_max ~ 14.99 m/s
#   - PBLH_max ~ 535.4 m  |  EddyDiff ~ 13.6 m^2/s
#
#   Fire: 32 active cells, Q_atm_max=3522 W/m^2, Max ROS=0.216 m/s
#
#   Dust Threshold:
#   - crust_min=1.049e-14 (burned)  crust_max=1.0 (unburned)
#   - u*_t_min=0.004741 m/s  u*_t_max=0.007111 m/s
#
#   Dust Emission:
#   - emission_sum = 3.874e-06 kg/s
#   - emission_flux bin0 max = 1.515e-08 kg/m^2/s
#   - F_dust_atm_max = 4.545e-08 kg/m^2/s
#
#   Concentrations: conc_sfc_max~26.6 ug/m^3 | PM10~25.3 | RHO DUST=3.884
#   dep_total = 7.934e-08 kg/m^2
#
# --- Step 100 (t=50 s, verified) ---
#
#   Dynamics:
#   - u*_max ~ 0.754 m/s  |  u_10m_max ~ 14.67 m/s
#   - PBLH_max ~ 537.8 m  |  T_sfc_max ~ 302.5 K (fire heating accumulated)
#   - EddyDiff::Scalar_v_max = 87.9 m^2/s  (fire heating over 50 s)
#
#   Fire (step 100):
#   - 32 active fire cells  |  phi_min=-1  phi_max=0
#   - Q_atm_max = 3364 W/m^2 (lagged, from previous step)
#   - Q_max = 3362 W/m^2  |  I_B_max = 37.4 kW/m  |  T_flame_max = 652 K
#   - FARSITE terrain wind corrections applied each step
#   - Effective wind max = 4.882 m/s at step 100 (vs 5.275 at step 20;
#     fire heating modifies near-surface wind over time)
#
#   Dust Threshold (step 100):
#   - crust_min=1.268e-70 (burned cells after 100 reductions: 1.0*(0.2)^100~0)
#   - crust_max=1.0 (unburned cells)
#   - u*_t_min=0.004741 m/s  u*_t_max=0.007111 m/s (same clamp limits)
#
#   Dust Emission (step 100):
#   - emission_sum = 3.609e-06 kg/s  (vs 3.874e-06 at step 20: -7%)
#     Slight decrease because fire heating over 50 s deepens PBL and
#     reduces near-surface u* (0.754 vs 0.771 m/s)
#   - emission_flux bin0 max = 1.419e-08 kg/m^2/s
#   - F_dust_atm_max = 4.258e-08 kg/m^2/s
#
#   Dust Concentrations (step 100):
#   - conc_sfc_max = 110.9 ug/m^3  (accumulating; 4x step 20 value)
#   - PM10_max = 110.2 ug/m^3
#   - MSHA_TWA = 1.051e-04 mg/m^3  (growing with time)
#   - RHO DUST = 19.787  (vs 3.884 at step 20: +410% mass accumulated)
#
#   Mass Budget (step 100):
#   - MASS = 1.013e+10  (conserved)
#   - RHO THETA = 3.080674e+12  (higher than step 20: fire heating)
#   - dep_total = 4.032e-07 kg/m^2  (vs 7.934e-08 at step 20: +408%)
#
#   Performance:
#   - Timestep wall time ~ 5.9e-03 s  |  Total ~ 0.617 s
#
# Key comparison: FireDustTerrainCoupled vs FireDustInteraction1 (flat, step 20):
#   - u*_max:       1.121 -> 0.771 m/s   (-31%, terrain sheltering)
#   - emission_sum: 1.190e-05 -> 3.874e-06 kg/s  (-67%, u*^3 scaling)
#   - RHO DUST:    11.944 -> 3.884               (-67%)
#   - u*_t range:  [0.00474, 0.00711]            (identical, correct)
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 1.0: start fully crusted; burned cells reduced each step
# by fire_dust_crust_reduction=0.8 -> crust * (1-0.8) = 0.2 -> near 0 after n steps
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors for terrain-coupled test:
# k_ridge=1.5: amplifies u* on ridgelines
# k_shelter=0.6: reduces u* in lee zones (dominant effect in this flat-terrain case)
# k_valley=0.8: reduces u* in valley zones
# k_deflect=0.3: reduces u* in flow-deflection zones
erf.dust.k_ridge = 1.5
erf.dust.k_shelter = 0.6
erf.dust.k_valley = 0.8
erf.dust.k_deflect = 0.3
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 600 m marks ~32 burned cells at t=0, consistent with
# FireDustInteraction1 for direct comparison of terrain wind effect
erf.fire.ignition_r = 600.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = true
erf.fire.coupling_type = "lagged"
erf.dust.use_terrain_wind = true
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# crust_reduction = 0.8: burned cells drop from crust=1.0 each step
# Step 20: crust_min=1.049e-14, Step 100: crust_min=1.268e-70 (converged to 0)
erf.fire_dust_crust_reduction = 0.8
