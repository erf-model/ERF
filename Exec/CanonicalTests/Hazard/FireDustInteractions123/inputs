# ============================================================
# Test: FireDustInteractions123
# Description: All three fire-dust interactions active simultaneously.
#
#   Interaction 1: burned area reduces crust_index -> lowers u*_t
#   Interaction 2: fire outflow wind -> raises u* via log-law max
#   Interaction 3: fire heat flux -> amplifies emission flux via lofting factor
#
#   All three reinforce each other in burned cells:
#     - u*_t is lower (burned cells see USTAR_T_MIN)
#     - u* is raised by fire wind (but MRF dominates at 15 m/s)
#     - emission flux is multiplied by lofting factor (capped at 3x)
#
# Settings:
#   crust_index = 0.5                -> Phase 1 active (partially crusted)
#   fire_dust_crust_reduction = 0.8  -> Phase 1: per-step crust decay in burned cells
#   fire_dust_wind_to_dust = true    -> Phase 2: fire wind -> dust u*
#   fire_dust_lofting_enabled = true -> Phase 3: heat flux lofting factor
#   k_loft = 2.0, Q_threshold = 50, Q_ref = 500
#   fire.coupling_type = "passive"   -> no heat injection into atmosphere
#   sounding_neutral_abl (u=15 m/s) -> consistent with geo_wind=15.0
#
# NOTE: geo_wind=5.0 in this file but sounding_neutral_abl has u=15 m/s.
#   This mismatch is intentional for testing: the run uses the sounding wind
#   for dynamics but geo_wind=5.0 for the driver. Results are verified as-is.
#   To make fully consistent use geo_wind=15.0 or sounding_weak_wind_abl.
#
# Expected Results (verified step=20, t=10 s, dt=0.5 s):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s.
#   - u*_max = 1.121391 m/s  |  u_10m_max = 14.994 m/s  |  PBLH = 534.723 m
#   - EddyDiff::Scalar_v_max = 2.167788435 m^2/s
#   - T_sfc_max = 300 K  (passive fire, no heating)
#
#   Fire (step 20):
#   - 32 active fire cells (ignition_r=600 m)
#   - Max reference wind = 14.56192582 m/s
#   - Max effective wind (post-WAF) = 5.272935425 m/s
#   - Max ROS = 0.2160244347 m/s  |  Q_max = 3520.16312 W/m^2
#   - T_flame_max = 536.5483447 K  |  phi_min=-1  phi_max=0
#
#   Phase 1 output (step 20):
#   - crust_min = 5.24288e-15  (burned, 20 reductions of 0.8)
#   - crust_max = 0.5          (unburned, initial value preserved)
#   - reduction = 0.8
#   - u*_t_min = 0.004740711511 m/s  |  u*_t_max = 0.005925889388 m/s
#
#   Phase 2 output (step 20):
#   - fire_wind_max = 5.272935425 m/s
#   - ustar_max_after = 1.12149862 m/s  (MRF dominates at 15 m/s background)
#   - C = 1  (fire.grid_ratio=2 / dust.grid_ratio=2)
#
#   Phase 3 output (step 20):
#   - fire_heat_max = 3520.16312 W/m^2  (> Q_threshold=50)
#   - emission_flux_max_after_loft = 1.394623626e-07 kg/m^2/s
#   - Pre-loft bin0 max = 4.64874542e-08 -> x3 cap -> 1.394e-07 (correct)
#
#   Dust Emission (step 20, after lofting):
#   - emission_sum = 1.487366183e-05 kg/s
#   - F_dust_atm_max = 4.18507198e-07 kg/m^2/s
#   - conc_sfc_max = 241.949 ug/m^3  |  PM10 = 229.838 ug/m^3
#   - RHO DUST = 14.919
#   - dep_total = 3.556256562e-07 kg/m^2
#
#   Mass Budget (step 20):
#   - MASS = 1.012650226e+10  |  RHO THETA = 3.080452531e+12
#   - RHO SCALAR = 0
#
#   Performance:
#   - Timestep wall time ~ 5.7e-03 s  |  Total ~ 0.128 s
#   - NOTE: amrex.max_grid_size_z is unused (use amr.max_grid_size_z instead)
#
# Comparison table (all step=20, passive fire, 15 m/s sounding):
#
#   Test               | Phases  | emission_sum    | RHO DUST | conc_sfc
#   -------------------|---------|-----------------|----------|----------
#   FireDustBaseline   | none    | ~1.189e-05      | ~11.9    | ~82 ug/m3
#   FireDustInteraction1| 1      | ~1.190e-05      | ~11.9    | ~82 ug/m3
#   FireDustInteraction2| 2      | ~1.189e-05      | ~11.9    | ~82 ug/m3
#   FireDustInteraction3| 3      | 1.4876e-05      | 14.92    | 242 ug/m3
#   FireDustInteractions123| 1+2+3 | 1.4874e-05   | 14.92    | 242 ug/m3
#
#   Key finding: Phase 3 (lofting) dominates the emission increase at 15 m/s
#   background wind. Phase 1 (crust reduction) is visible in u*_t variation.
#   Phase 2 (wind) cannot overcome MRF u* at 15 m/s. Combined test confirms
#   all three phases compose without double-counting or instability.
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
# sounding_neutral_abl: u=15 m/s
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
# NOTE: geo_wind=5.0 retained from original inputs (see header note above)
erf.abl_geo_wind = 5.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 0.5: partially crusted; Phase 1 active
erf.dust.crust_index = 0.5
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 600 m marks ~32 burned cells at t=0
erf.fire.ignition_r = 600.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = false
# coupling_type = passive: fire heat NOT injected into atmosphere
erf.fire.coupling_type = "passive"
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# Phase 1: crust reduction in burned cells
erf.fire_dust_crust_reduction = 0.8
# Phase 2: fire wind -> dust u* via log-law max
erf.fire_dust_wind_to_dust = true
erf.fire_dust_wind_z0 = 0.1
erf.fire_dust_wind_zref = 6.1
# Phase 3: lofting factor = 1 + k_loft * max(Q-Q_threshold,0)/Q_ref (capped at 1+k_loft=3)
erf.fire_dust_lofting_enabled = true
erf.fire_dust_lofting_k_loft = 2.0
erf.fire_dust_lofting_Q_threshold = 50.0
erf.fire_dust_lofting_Q_ref = 500.0
