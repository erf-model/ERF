# ============================================================
# Test: FireDustInteraction2
# Description: Fire-dust Phase 2 coupling — fire outflow wind raises
#              effective friction velocity on dust grid.
#              Phase 1 (crust reduction) is disabled so only the
#              fire wind effect drives emission changes.
#
# Physics:
#   FireLayer::advance() computes fire_wind_eff each timestep via
#   ERF_FireWindExtract. apply_fire_wind_to_dust_ustar averages
#   fire_wind_eff over the C×C fire-to-dust grid cells, derives
#   u* = U * kappa / ln(zref/z0), and takes the max with MRF u*.
#   With weak background wind (5 m/s) and fire_wind_eff_max=1.79 m/s,
#   the fire-derived u* = 1.79*0.4/ln(6.1/0.1) = 1.79*0.4/4.11 = 0.174 m/s
#   but MRF u* = 0.374 m/s (still dominant). However, fire_wind_eff is the
#   POST-WAF midflame wind. The ambient wind seen by the dust module
#   separately via Phase 9 (MRF surface layer) gives u*=0.374 m/s.
#   Phase 2 correctly applies max(0.374, 0.174) = 0.374 m/s.
#
# Key contrast with 15 m/s background:
#   At 5 m/s: MRF u*=0.374 m/s, fire_wind_max=1.792 m/s, fire u*=0.174 m/s
#             -> Phase 2 leaves u* unchanged (MRF dominates)
#   At 15 m/s: MRF u*=1.121 m/s, fire_wind_max=5.273 m/s, fire u*=0.513 m/s
#             -> Phase 2 also leaves u* unchanged (MRF still dominates)
#   In both cases the WAF reduces fire_wind_eff well below ambient wind,
#   so Phase 2 has no visible effect on u* for these conditions.
#   Phase 2 would dominate in calm conditions (u_ambient < ~1 m/s)
#   where fire-generated convective outflow exceeds the background.
#
# Phase isolation:
#   crust_index = 1.0                  -> standard crusted soil
#   fire_dust_crust_reduction = 0.0    -> Phase 1 inactive (verified:
#                                         crust_min=1, crust_max=1, reduction=0)
#   fire_dust_wind_to_dust = true      -> Phase 2 active and wired
#   fire.coupling_type = "passive"     -> fire heat NOT injected
#
# Expected Results (verified step=20, t=10 s, dt=0.5 s, sounding_weak_wind_abl):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s.
#   - Anelastic dt ~ 75.0 s  |  CFL compressible dt ~ 1.06 s
#   - u*_max = 0.374 m/s  |  u_10m_max = 5.000 m/s  |  PBLH = 476.2 m
#   - EddyDiff::Scalar_v_max = 0.252 m^2/s  (passive fire, low wind)
#   - T_sfc_max = 300 K  (no fire heating, coupling_type=passive)
#
#   Fire (step 20):
#   - 32 active fire cells (ignition_r=600 m), passive coupling.
#   - Max reference wind = 4.949 m/s  |  Max effective wind (post-WAF) = 1.792 m/s
#   - Max ROS = 0.2160244347 m/s  |  Q_max = 3520 W/m^2 (not injected)
#   - phi_min=-1  phi_max=0
#
#   Phase 1 output (step 20):
#   - crust_min=1, crust_max=1, reduction=0  (Phase 1 fully disabled)
#   - u*_t = 0.007111 m/s (crust=1.0, alpha_crust=0.5: 0.00474*1.5=0.00711)
#
#   Phase 2 output (step 20):
#   - [DUST DEBUG] Phase 2 fire-wind coupling:
#       fire_wind_max=1.792230779 m/s
#       ustar_max_after=0.3740316844 m/s
#       C=1
#   - fire-derived u* = 1.792*0.4/ln(6.1/0.1) = 0.174 m/s
#   - MRF u* = 0.374 m/s  ->  max() keeps MRF u* (correct)
#   - Phase 2 is wired and active; fire wind does not dominate at 5 m/s wind
#
#   Dust Emission (step 20):
#   - emission_sum = 4.474751e-07 kg/s
#     (27× lower than FireDustBaseline at 15 m/s — emission ~ u*^3, (0.374/1.121)^3 ~ 0.037)
#   - emission_flux bin0 max = 1.748e-09 kg/m^2/s
#   - F_dust_atm_max = 5.244e-09 kg/m^2/s
#   - conc_sfc_max = 3.105 ug/m^3  |  PM10 = 2.942 ug/m^3
#   - RHO DUST = 0.448  (vs 11.924 at 15 m/s: -96%, expected from u*^3 scaling)
#   - dep_total = 7.430e-09 kg/m^2
#
#   Mass Budget (step 20):
#   - MASS = 1.013e+10  |  RHO THETA = 3.080452531e+12 (same as 15 m/s baseline)
#   - RHO SCALAR = 0
#
#   Performance:
#   - Timestep wall time ~ 5.6e-03 s  |  Total ~ 0.126 s
#
#   Comparison FireDustInteraction2 vs FireDustBaseline (crust=1.0, 15 m/s):
#   - u*_max:          1.121 -> 0.374 m/s      (-67%, weak wind)
#   - emission_sum:    1.234e-05 -> 4.475e-07  (-96%, u*^3 scaling confirmed)
#   - ustar_max_after: same as MRF u* in both cases (Phase 2 max() correct)
#
#   NOTE: To observe fire wind DOMINATING MRF u*, use calm conditions
#   (u_ambient < ~1 m/s) where fire convective outflow exceeds background.
#   The current test validates wiring and correct max() selection logic.
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
# sounding_weak_wind_abl: u=5 m/s to reduce background MRF u* (~0.374 m/s)
# vs sounding_neutral_abl (u=15 m/s, MRF u*~1.121 m/s)
# Both cases: fire post-WAF wind < MRF u*, so max() selects MRF u* (correct)
erf.input_sounding_file = "sounding_weak_wind_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
# geo_wind = 5.0 consistent with sounding_weak_wind_abl
erf.abl_geo_wind = 5.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
# (assertion enforced in code). Both set to 2 for all fire-dust tests.
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 1.0: standard fully crusted soil
# fire_dust_crust_reduction = 0.0 disables Phase 1; verified crust_min=1, crust_max=1
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors are neutral (1.0) since use_terrain_wind=false
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 600 m marks ~32 burned cells at t=0 (~12.5% of fire domain)
erf.fire.ignition_r = 600.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = false
# coupling_type = passive: fire heat NOT injected, so EddyDiff unchanged
# This isolates Phase 2 (wind effect) from fire heating effects
erf.fire.coupling_type = "passive"
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# crust_reduction = 0.0: Phase 1 fully disabled (verified: crust stays at 1.0)
erf.fire_dust_crust_reduction = 0.0
# Phase 2: fire outflow wind -> dust u* via log-law, max with MRF u*
erf.fire_dust_wind_to_dust = true
erf.fire_dust_wind_z0 = 0.1
erf.fire_dust_wind_zref = 6.1
