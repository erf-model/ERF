# crust_reduction = 0.99: burned cells drop from crust=1.0 -> 0.01
# (nearly bare soil, ~100x higher emission vs unburned cells)
# With ~32 burned cells (~12.5% domain) this produces a visible
# increase in domain-integrated emission_sum vs FireDustBaseline
erf.fire_dust_crust_reduction = 0.99
