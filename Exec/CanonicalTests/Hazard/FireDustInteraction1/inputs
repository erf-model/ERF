# ============================================================
# Test: FireDustInteraction1
# Description: Fire and dust with active fire-dust coupling
#              (fire_dust_coupling = true) using lagged wind coupling.
#              Fire burned areas reduce the dust crust index,
#              leading to increased dust emission in post-fire zones.
#              Flat terrain, no terrain wind.
#
# Grid ratios: dust.grid_ratio = fire.grid_ratio = 2
#   (16x16 dust/fire grid over 3000 m domain, dx=187.5 m)
#   REQUIRED: dust.grid_ratio must equal fire.grid_ratio when
#   fire_dust_coupling=true, otherwise burned cells are sub-grid
#   on the dust grid and crust reduction has no effect. An assertion
#   in the code enforces this and aborts if they differ.
#
# Ignition: ignition_r = 600 m marks ~32 burned fire cells at t=0
#   (~12.5% of the 256-cell fire domain).
#
# Crust reduction: fire_dust_crust_reduction = 0.99
#   Burned cells: crust drops from 1.0 -> 0.01 (nearly bare soil).
#   Unburned cells: crust = 1.0 (fully protected).
#   With ~32 burned cells at ~100x higher emission rate, the
#   domain-integrated emission_sum increase vs FireDustBaseline
#   should be clearly visible (expected ~10-15% higher).
#
# Expected Results:
#   - Simulation completes 20 steps without errors.
#   - Fire ignites at (1500, 1500) with radius 600 m and spreads
#     outward using Rothermel (fuel_model_id=1) rate of spread.
#   - In cells where fire_phi < 0 (burned), the dust crust index is
#     reduced by fire_dust_crust_reduction = 0.99, i.e., crust -> 0.01.
#     Starting from crust_index = 1.0, burned cells have crust = 0.01
#     while unburned cells retain crust = 1.0.
#   - Dust emission flux in burned areas is ~100x higher than in
#     unburned areas (crust 0.01 vs 1.0).
#   - Total domain-integrated emission_sum is visibly higher than
#     FireDustBaseline (fire_dust_coupling=false) due to post-fire
#     crust reduction over ~12.5% of the domain.
#   - Lagged coupling: fire spread uses wind from previous atm timestep.
#   - Fire heat flux injected into atmosphere raises EddyDiff.
#   - Dust concentrations remain non-negative across all bins.
#   - No NaNs or floating-point exceptions.
#
# NOTE: Expected results will be updated after verified run.
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
amr.max_grid_size_z = 32
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
# (assertion enforced in code). Both set to 2 for all fire-dust tests.
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors are neutral (1.0) since use_terrain_wind=false
# for this flat-terrain test
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
