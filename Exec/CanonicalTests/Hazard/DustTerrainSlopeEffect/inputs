# ============================================================
# Test: DustTerrainSlopeEffect
# Description: Dust emission and transport over a 10-degree sloped
#              terrain driven by a neutral ABL with geostrophic wind.
#              No fire coupling. Terrain wind effects are enabled.
#
# Expected Results (verified step=20, t=10 s, dt=0.5 s, 4096 cells):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s (compressible dt ~1.031 s, anelastic ~25.0 s).
#   - u*_max = 1.155887464 m/s  |  u_10m_max = 22.49132767 m/s
#   - PBLH_max = 534.72106 m    |  T_sfc_max = 300 K
#   - EddyDiff::Scalar_v_max = 2.167818648 m^2/s
#
#   Terrain Wind Effect:
#   - terrain_slope_10deg.asc read successfully.
#   - k_ridge=1.5 amplifies effective wind on upwind slope:
#     u_10m_max = 22.491 m/s vs. 14.994 m/s flat (+50.0%) ✓
#   - k_shelter, k_valley, k_deflect = 1.0 (neutral):
#     uniform slope geometry; lee/valley/deflect paths not meaningful.
#
#   Dust Threshold (step 20):
#   - Phase 7: crust_min=0, crust_max=0  (same as DustTerrainFlat:
#     DustLayer resets crust to 0 internally when no fire coupling)
#   - u*_t_min = 0.005128846206 m/s  |  u*_t_max = 0.007333296069 m/s
#     (spatially varying due to terrain wind modifying threshold)
#   - u*_in range: [0.7705916424, 1.155887464] m/s
#
#   Dust Emission (step 20):
#   - Only bin 0 (d=7 um) active  |  n_active_bins=1
#   - emission_flux bin0 max = 5.095766939e-08 kg/m^2/s
#   - emission_sum = 2.970431769e-06 kg/s
#   - F_dust_atm_max = 1.52897459e-07 kg/m^2/s
#
#   Dust Settling & Deposition (step 20):
#   - Settling velocity bin0 (d=7 um): v_s = 0.004000674647 m/s
#   - Deposition velocity: v_d = 0.007413398738 m/s
#   - dep_flux_max = 7.082632146e-11 kg/m^2/s
#   - dep_total (accumulated) = 7.151193619e-08 kg/m^2
#
#   Dust Concentrations (step 20):
#   - conc_sfc_max = 92.78530622 ug/m^3
#   - PM10_max = 87.89374485 ug/m^3  |  PM2.5_max = 0 ug/m^3
#   - MSHA_TWA = 1.605362559e-05 mg/m^3  (below occupational limit)
#   - All dust concentrations non-negative.
#
#   Mass Budget (step 20):
#   - RHO DUST = 11.909882
#   - MASS = 1.012650226e+10  |  RHO THETA = 3.080452531e+12
#   - RHO SCALAR = 0
#
#   Performance:
#   - Timestep wall time ~ 5.4e-03 s  |  Total ~ 0.120 s
#
# Slope vs Flat comparison (verified run numbers, step=20):
#
#   Metric               | DustTerrainFlat   | DustTerrainSlopeEffect | Delta
#   ---------------------|-------------------|------------------------|------
#   u*_max [m/s]         | 1.121392          | 1.155887               | +3.1%
#   u_10m_max [m/s]      | 14.994            | 22.491                 | +50.0% (k_ridge=1.5)
#   u*_t_min [m/s]       | 0.004741 (uniform)| 0.005129               | spatially varying
#   u*_t_max [m/s]       | 0.004741 (uniform)| 0.007333               | spatially varying
#   emission_flux [kg/m2/s]| 4.6439e-08      | 5.0958e-08             | +9.7%
#   emission_sum [kg/s]  | 2.972e-06         | 2.970e-06              | ~same (uniform domain)
#   conc_sfc_max [ug/m3] | 81.557            | 92.785                 | +13.7%
#   PM10_max [ug/m3]     | 77.383            | 87.894                 | +13.6%
#   dep_total [kg/m2]    | 7.106e-08         | 7.151e-08              | +0.6%
#   RHO DUST             | 11.924            | 11.910                 | ~same
#
#   Key finding: k_ridge=1.5 boosts u_10m by 50% and emission flux by ~10%.
#   The u*_t range is now spatially varying (terrain modifies threshold).
#   Near-surface concentration is 13.7% higher on the slope.
#
# NOTE on terrain geometry: terrain_slope_10deg.asc is a spatially
# uniform 10-degree slope. All cells share the same upwind aspect
# relative to the x-direction geostrophic wind (15 0 0). Therefore
# k_shelter and k_valley are set to 1.0 (neutral) for this test;
# their spatial selectivity is exercised in separate tests that use
# non-uniform terrain with distinct ridge, valley, and lee zones.
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
erf.dust.grid_ratio = 1
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 1.0 set here but DustLayer resets crust to 0 internally
# when no fire coupling is active (same behaviour as DustTerrainFlat).
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# k_ridge = 1.5: amplifies u* on upwind slope face (active factor for this test)
# k_shelter, k_valley, k_deflect = 1.0: neutral — uniform slope geometry means
# all cells share same aspect; lee/valley/deflect paths are not meaningful here
erf.dust.k_ridge = 1.5
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.dust.use_terrain_wind = true
erf.dust.terrain_file = "terrain_slope_10deg.asc"
