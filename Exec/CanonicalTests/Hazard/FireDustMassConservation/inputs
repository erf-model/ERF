# ============================================================
# Test: FireDustMassConservation
# Description: Longer simulation (100 steps, t=0 to 50 s) to verify
#              dust mass evolution under fire-dust coupling.
#              Deposition is disabled (deposition_E0 = 0.0) so total
#              airborne dust mass should be non-decreasing. Lagged
#              fire-wind coupling with crust reduction in burned zones.
#              Flat terrain, no terrain wind.
#
# Grid ratios: dust.grid_ratio = fire.grid_ratio = 2
#   REQUIRED: must match when fire_dust_coupling=true.
#   ignition_r = 200 m >= fire grid cell size (187.5 m at grid_ratio=2)
#   marks ~4 burned cells at t=0. With crust_index=1.0 and
#   crust_reduction=0.8, burned cells have crust->0 over time.
#
# Expected Results (verified step=100, t=50 s, dt=0.5 s):
#
#   Dynamics:
#   - Simulation completes 100 steps without errors.
#   - Fixed dt = 0.5 s.
#   - EddyDiff::Scalar_v_max = 41.0436419 m^2/s  (fire heating grows BL)
#   - u*_max = 1.079892165 m/s  |  u_10m_max = 14.66152983 m/s
#   - PBLH_max = 535.2122451 m
#   - T_sfc_max = 300 K  (surface temp from MOST, fire heating in BL)
#
#   Fire (step 100):
#   - 4 active fire cells  (ignition_r=200 m, slow spread)
#   - phi_min=-1  phi_max=0
#   - Q_atm_max = 840.8885242 W/m^2  (lagged, from previous step)
#   - Q_max = 3361.617029 W/m^2  |  I_B_max = 37.35425503 kW/m
#   - T_flame_max = 651.7021367 K
#   - Max ROS = 0.2160244347 m/s  |  Max eff wind = 4.827585362 m/s
#   - Surface temp range: 299.923 - 300.658 K  (fire heating over 50 s)
#
#   Phase 2 fire-wind coupling (step 100):
#   - fire_wind_max = 4.820176387 m/s
#   - ustar_max_after = 1.080589961 m/s  (MRF u* dominates)
#   - C = 1
#
#   Dust Threshold (step 100):
#   - crust_min = 0  crust_max = 0  (entire domain reached crust=0)
#   - u*_t uniform = 0.004740711511 m/s  (USTAR_T_MIN floor, crust=0)
#
#   Dust Emission (step 100):
#   - emission_sum = 1.061848919e-05 kg/s
#   - emission_flux bin0 max = 4.147847339e-08 kg/m^2/s
#   - F_dust_atm_max = 1.246764471e-07 kg/m^2/s
#   - u*_in range: [1.079892165, 1.079892165] m/s (uniform)
#
#   Dust Concentrations (step 100):
#   - conc_sfc_max = 331.126908 ug/m^3  (accumulating, no dry deposition)
#   - PM10_max = 331.126908 ug/m^3
#   - MSHA_TWA = 3.178733566e-04 mg/m^3  (growing monotonically)
#
#   Deposition (step 100):
#   - dep_total = 7.815415087e-07 kg/m^2  (Stokes settling only, E0=0)
#   - deposition_E0=0.0: dry deposition disabled; only gravitational
#     settling (v_d=0.004001745324 m/s at u*=1.080 m/s) contributes.
#
#   Mass Budget (step 100):
#   - No NaNs, no negative concentrations.
#   - RHO DUST grows monotonically over 100 steps (confirmed mass-conservative).
#
#   Performance:
#   - Timestep wall time ~ 5.7e-03 s  |  Total ~ 0.598 s
# ============================================================

erf.prob_name = "ABL"
max_step = 100
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 10
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 1.0: start with fully crusted soil; burned cells will
# be reduced to crust=0 over time by fire_dust_crust_reduction=0.8 each step.
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
# deposition_E0 = 0.0: dry deposition disabled so airborne mass is non-decreasing
erf.dust.deposition_E0 = 0.0
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors are neutral (1.0) since use_terrain_wind=false
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 200 m marks ~4 burned cells at t=0 (slow-growth test)
erf.fire.ignition_r = 200.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = false
erf.fire.coupling_type = "lagged"
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# crust_reduction = 0.8: burned cells decay from crust=1.0 -> 0 over time
erf.fire_dust_crust_reduction = 0.8
