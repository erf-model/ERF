# ============================================================
# Test: FireDustLoftingScaling
# Description: Phase 3 lofting sensitivity to fire intensity (fuel model).
#   Verifies that stronger fires (higher Q_max) trigger the lofting factor
#   and that the cap (1 + k_loft) is correctly enforced.
#
# This test uses FM4 (chaparral, high heat flux).
# Compare with FireDustInteraction3 (FM1, low heat flux) at same conditions.
#
# Settings:
#   fuel_model_id = 4                -> FM4 chaparral (Q_max ~ 288,713 W/m^2)
#   crust_index = 0.5                -> uniform (Phase 1 inactive)
#   fire_dust_crust_reduction = 0.0  -> Phase 1 disabled
#   fire_dust_wind_to_dust = false   -> Phase 2 disabled
#   fire_dust_lofting_enabled = true -> Phase 3 active
#   k_loft = 2.0  Q_threshold = 50 W/m^2  Q_ref = 500 W/m^2
#   sounding_neutral_abl (u=15 m/s) -> consistent with geo_wind=15.0
#   fire.coupling_type = "passive"   -> no heat injection into atmosphere
#
# FM1 vs FM4 lofting comparison at step=20 (15 m/s sounding, Phase 3 only):
#
#   Metric                        | FM1 (Interaction3) | FM4 (LoftingScaling)
#   ------------------------------|--------------------|-----------------------
#   Q_max [W/m^2]                 | 3,520              | 288,712.9252
#   T_flame_max [K]               | 536.5              | 1304.915032
#   Max ROS [m/s]                 | 0.216              | 0.8449813953
#   lofting factor at fire cells  | capped at 3        | capped at 3
#   emission_flux_max_after [kg/m2/s] | 1.39463e-07    | 1.39463e-07
#   emission_sum [kg/s]           | 1.4876e-05         | 1.4876e-05
#   RHO DUST                      | 14.921             | 14.921
#
# Key finding: Both FM1 and FM4 saturate the lofting cap (factor = 1+k_loft = 3).
#   FM4: factor = 1 + 2*(288713-50)/500 = 1+1155 -> capped at 3
#   FM1: factor = 1 + 2*(3520-50)/500  = 1+13.88 -> capped at 3
#   Both Q values far exceed Q_ref=500, so identical post-loft emission.
#   This confirms the cap is enforced correctly for both weak and intense fires.
#   To differentiate FM1 vs FM4 in emission, raise Q_ref (e.g. 100,000 W/m^2).
#
# Expected Results (verified, FM4, step=20, t=10 s, sounding_neutral_abl):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s.
#   - u*_max = 1.121392194 m/s  |  u_10m_max = 14.994 m/s  |  PBLH = 534.721 m
#   - EddyDiff::Scalar_v_max = 2.167818648 m^2/s
#   - T_sfc_max = 300 K  (passive fire, no heating)
#
#   Fire FM4 (step 20):
#   - 32 active fire cells (ignition_r=600 m)
#   - Max reference wind = 14.56193684 m/s
#   - Max effective wind (post-WAF) = 7.962453917 m/s
#   - Max ROS = 0.8449813953 m/s
#   - Q_max = 288712.9252 W/m^2  |  I_B_max = 2489.759636 kW/m
#   - T_flame_max = 1304.915032 K
#   - phi_min=-1  phi_max=0
#
#   Phase 3 output (step 20):
#   - [DUST DEBUG] Phase 3 fire-lofting:
#       step=20
#       fire_heat_max=288712.9252 W/m2
#       emission_flux_max_after_loft=1.39462757e-07 kg/m2/s
#   - Pre-loft bin0 max = 4.648758566e-08 kg/m^2/s
#   - factor = 1 + 2*(288713-50)/500 -> capped at 3
#   - lofted = 3 * 4.649e-08 = 1.395e-07 (matches output) ✓
#
#   Phase 1+2 disabled (step 20):
#   - crust_min=0.5, crust_max=0.5, reduction=0  (Phase 1 inactive)
#   - u*_t = 0.005925889388 m/s (uniform, crust=0.5)
#
#   Dust Emission (step 20, after lofting):
#   - emission_sum = 1.487602741e-05 kg/s
#   - F_dust_atm_max = 4.185084176e-07 kg/m^2/s
#   - conc_sfc_max = 241.958 ug/m^3  |  PM10 = 229.846 ug/m^3
#   - RHO DUST = 14.921
#   - dep_total = 3.556812621e-07 kg/m^2
#
#   Mass Budget (step 20):
#   - MASS = 1.012650226e+10  |  RHO THETA = 3.080452531e+12
#   - RHO SCALAR = 0
#
#   Performance:
#   - Timestep wall time ~ 5.7e-03 s  |  Total ~ 0.127 s
#   - NOTE: amrex.max_grid_size_z is unused (use amr.max_grid_size_z instead)
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
# sounding_neutral_abl: u=15 m/s, consistent with geo_wind=15.0
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
# geo_wind = 15.0 consistent with sounding_neutral_abl
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
# dust.grid_ratio must equal fire.grid_ratio when fire_dust_coupling=true
erf.dust.grid_ratio = 2
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 0.5: uniform partially crusted (Phase 1 inactive)
erf.dust.crust_index = 0.5
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2
# FM4 chaparral: Q_max=288,713 W/m^2 vs FM1 Q_max=3,520 W/m^2 (82x)
# Both saturate the lofting cap (k_loft=2, Q_ref=500).
# Change to fuel_model_id = 1 to reproduce FireDustInteraction3 baseline.
erf.fire.fuel_model_id = 4
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1500.0
erf.fire.ignition_y = 1500.0
# ignition_r = 600 m marks ~32 burned cells at t=0
erf.fire.ignition_r = 600.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = false
# coupling_type = passive: fire heat NOT injected into atmosphere
erf.fire.coupling_type = "passive"
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
erf.fire_dust_coupling = true
# Phase 1 disabled
erf.fire_dust_crust_reduction = 0.0
# Phase 2 disabled
erf.fire_dust_wind_to_dust = false
# Phase 3: lofting factor = 1 + k_loft * max(Q-Q_threshold,0)/Q_ref (capped at 1+k_loft=3)
# Both FM1 and FM4 saturate the cap at these parameters.
# To differentiate fuel models: raise Q_ref to e.g. 100000 W/m^2.
erf.fire_dust_lofting_enabled = true
erf.fire_dust_lofting_k_loft = 2.0
erf.fire_dust_lofting_Q_threshold = 50.0
erf.fire_dust_lofting_Q_ref = 500.0
