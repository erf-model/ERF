# ============================================================
# Test: DustTerrainFlat
# Description: Dust emission and transport over a flat terrain
#              driven by a neutral ABL with geostrophic wind.
#              No fire coupling. No terrain wind effects.
#
# Expected Results (verified from simulation output at step 20,
#                   t = 10 s, dt = 0.5 s, 4096 cells):
#
#   Dynamics:
#   - Simulation completes 20 steps without errors.
#   - Fixed dt = 0.5 s (CFL-limited compressible dt ~1.03 s,
#     anelastic dt ~25.0 s; fixed dt is binding).
#   - u*_max ~ 1.121 m/s  |  u_10m_max ~ 14.99 m/s
#   - PBLH_max ~ 534.7 m  |  T_sfc = 300 K
#
#   Dust Emission (step 20):
#   - Only bin 0 (d = 7 um) is active (n_active_bins = 1).
#   - F_dust_max (atm coupling flux) = 1.447e-07 kg/m^2/s
#   - emission_flux bin0 max = 4.821e-08 kg/m^2/s
#   - emission_sum = 1.234186e-05 kg/s
#   - u*_t min = max = 0.007111 m/s (crust_index=1.0, alpha_crust=0.5,
#     USTAR_T_MIN=0.001; Bagnold base ~0.00474 m/s * f_chem(1.5) = 0.00711)
#   - With flat terrain (use_terrain_wind = false), emission is
#     spatially uniform (periodic domain).
#
#   Dust Settling & Deposition (step 20):
#   - Settling velocity bin0 (d=7 um) v_s = 4.001e-03 m/s
#   - Deposition velocity v_d = 7.311e-03 m/s
#   - dep_flux_max = 6.609e-11 kg/m^2/s
#   - dep_total (accumulated) ~ 2.951e-07 kg/m^2
#
#   Dust Concentrations (step 20):
#   - conc_sfc_max ~ 84.7 ug/m^3
#   - PM10_max ~ 80.3 ug/m^3  |  PM2.5_max = 0 ug/m^3
#   - MSHA TWA ~ 1.333e-05 mg/m^3 (below occupational limit)
#   - All dust concentrations non-negative.
#
#   Mass Budget (step 20):
#   - RHO DUST ~ 12.379
#   - MASS = 1.013e+10  |  RHO THETA = 3.080e+12
#   - RHO SCALAR = 0 (passive scalar inactive)
#
#   MRF Diffusion:
#   - EddyDiff::Scalar_v_max = 2.168 m^2/s
#   - gamma_dust = 0 (no countergradient term for dust scalar)
#   - moisture_path_active = 0 (use_dynamic_moisture = false)
#
#   PHREEQC / suppression:
#   - do_phreeqc = 1 (reader active, no external file)
#   - suppression coverage max = 0, retreat_flag sum = 0
#
#   Performance:
#   - Timestep wall time ~ 4.3e-03 s  |  Total ~ 0.106 s
# ============================================================

erf.prob_name = "ABL"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
geometry.prob_extent = 3000 3000 1024
amr.n_cell = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
# max_grid_size_z = 64 keeps all 64 vertical levels in one box (no z decomposition)
amr.max_grid_size_z = 64
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.5
erf.sum_interval = 1
erf.v = 1
amr.v = 1
erf.plot_int_1 = -1
erf.check_int = -1
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = false
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.transport_scalar = true
erf.dust.enable = true
erf.dust.dust_debug = true
erf.dust.grid_ratio = 1
erf.dust.n_size_bins = 3
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.0123
# crust_index = 1.0: fully crusted soil (maximum protection)
# u*_t = A*sqrt(rho_p*g*d/rho_a) * (1 + alpha_crust*1.0) = 0.00474 * 1.5 = 0.00711 m/s
erf.dust.crust_index = 1.0
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.use_dynamic_moisture = false
# Terrain wind k-factors are neutral (1.0) since use_terrain_wind=false
# for this flat-terrain test
erf.dust.k_ridge = 1.0
erf.dust.k_shelter = 1.0
erf.dust.k_valley = 1.0
erf.dust.k_deflect = 1.0
erf.dust.dust_plot_int = -1
erf.dust.phreeqc_output_file = ""
erf.dust.blast_schedule_file = ""
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""
