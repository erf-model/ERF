# Phase 3 of the immersed-boundary surface energy balance: view fractions
# by hemisphere sampling and the longwave balance through them. The two
# boxes of phase 2 (a tall one and a short one 40 m east of it) on a 5 m
# grid, two steps. Variants: inputs_fixed (sky longwave given), inputs_gray
# (sky longwave from the air temperature). The face dump at step 2 is what
# check_longwave.py reads.
geometry.prob_extent =  640     640    640
amr.n_cell           =  128     128    128

geometry.is_periodic = 1 1 0

zlo.type = "NoSlipWall"
zhi.type = "SlipWall"

# TIME STEP CONTROL
erf.fixed_dt           = 0.125  # fixed time step depending on grid resolution
erf.substepping_cfl    = 0.5

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# planar averaging (with erf.v = 1)

# CHECKPOINT FILES
erf.check_file      = chk        # root name of checkpoint file
erf.check_int       = -1

# PLOTFILES
erf.plot_file_1     = plt       # prefix of plotfile name
erf.plot_int_1      = 4
erf.plot_vars_1     = terrain_IB_mask ibseb_nfaces ibseb_tskin ibseb_sw_abs ibseb_shadow ibseb_lw_net ibseb_f_sky

# SOLVER CHOICE
erf.use_gravity = true

erf.molec_diff_type = "None"
erf.les_type        = "Smagorinsky"
erf.Cs              = 0.17

erf.rayleigh_damp_U = true
erf.rayleigh_damp_V = true
erf.rayleigh_damp_W = true
erf.rayleigh_damp_T = true
prob.dampcoef = 0.2 # [1/s] following FastEddy
prob.zdamp = 300. # from model top"

# INITIALIZATION 
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding_CBL"

## TERRRAIN GRID TYPE
erf.buildings_type = ImmersedForcing
erf.buildings_file_name = two_buildings_5m_128x128.txt
erf.immersed_forcing_substep = true
eb2.small_volfrac = 0.005

# Coriolis parameter f = 
erf.use_coriolis = true
erf.latitude = 40.0
erf.rotational_time_period = 86400.0

# Geostrophic wind 
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 8.0 0.0 0.0

erf.ibseb.enable = true
erf.ibseb.prognostic = false        # phase test: the skin stays fixed so each term is checked on its own
erf.ibseb.n_slab_layers = 4
erf.ibseb.T_skin_init = 300.0
erf.ibseb.T_interior = 293.0
erf.ibseb.csv_int = 2
erf.ibseb.debug = true
erf.ibseb.albedo = 0.3
erf.ibseb.albedo_ground = 0.2
max_step = 2
erf.ibseb.sun_mode = "fixed"
erf.ibseb.sun_zenith_deg = 60.0
erf.ibseb.sun_azimuth_deg = 270.0
erf.ibseb.sw_direct_normal = 800.0
erf.ibseb.sw_diffuse = 100.0
erf.ibseb.emissivity = 0.9
erf.ibseb.emissivity_ground = 0.95
erf.ibseb.T_ground = 300.0
erf.ibseb.view_n_az = 16
erf.ibseb.view_n_el = 8
