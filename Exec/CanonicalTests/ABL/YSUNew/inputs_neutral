# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Neutral Atmospheric Boundary Layer Test Case - YSUNew Scheme
# 
# Neutral conditions characterized by:
#   - Zero surface heat flux (adiabatic surface)
#   - Uniform potential temperature profile
#   - Shear-driven turbulence from mean wind
#   - PBL height governed by wind shear: h ~ u*/f
#
# This case tests YSUNew performance in neutral stability where:
# - Countergradient corrections (HGAMT) should have minimal effect
# - Diffusivity driven by wind shear rather than buoyancy
# - Suitable for validating base YSUNew physics

erf.prob_name = "ABL"

max_step = 100

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
geometry.prob_extent = 4000  4000  2000
amr.n_cell           =  4   4   64
geometry.is_periodic = 1 1 0

# MOST BOUNDARY - Adiabatic surface (zero heat flux for neutral conditions)
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m]
erf.most.zref = 10.0     # reference height [m]
erf.most.surf_temp = 300.0  # surface temperature [K]
erf.most.surf_temp_flux = 0.0  # zero heat flux for neutral conditions

zhi.type = "SlipWall"
zhi.theta_grad = 0.0  # adiabatic upper boundary

# TIME STEP CONTROL
erf.fixed_dt = 0.1  # time step [s]

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk_neutral     # root name of checkpoint file
erf.check_int       = 100             # number of timesteps between checkpoints

# DATA COLLECTION
erf.data_log    = neutral_hist.dat neutral_profiles.dat
erf.profile_int = 10

# PLOTFILES
erf.plot_file_1     = plt_neutral      # prefix of plotfile name
erf.plot_int_1      = 15               # number of timesteps between plotfiles
erf.plot_vars_1     = density rhoadv_0 rhoadv_1 x_velocity y_velocity z_velocity pressure temp theta

# SOLVER CHOICE
erf.use_gravity = true

erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.theta_ref = 300.0

# INITIALIZATION - from sounding file
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding_YSUNew_neutral"

# PBL CONFIGURATION - YSUNew (neutral case)
erf.pbl_type = "YSUNew"
erf.enable_ysu_countergradient = false
erf.enable_ysu_entrainment = false
erf.ysu_moistvars = false

# CORIOLIS EFFECT
erf.latitude = 45.0  # mid-latitude
erf.use_coriolis = true
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0
