# erf.pbl_ysu_use_consistent_coriolis = false
# erf.pbl_ysunew_highres_bounds = false
# erf.ysu_moistvars = false
# erf.ysu_qcloud_threshold = 1.0e-4

# WRF-style HGAMT/HGAMQ correction for PBL height (heat + moisture countergradient)

# WRF-style moisture diffusivity (Prq ~ Prt)

# PROBLEM PARAMETERS


# Higher values of perturbations lead to instability
# Instability seems to be coming from BC

# CORIOLIS EFFECT
erf.latitude = 45.0  # mid-latitude (f = 1.0e-4 s^-1)

erf.use_coriolis = true

erf.abl_driver_type = "GeostrophicWind"

erf.abl_geo_wind = 10.0 0.0 0.0
