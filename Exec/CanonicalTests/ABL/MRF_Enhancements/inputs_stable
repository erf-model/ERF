# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Stable Atmospheric Boundary Layer Test Case
# 
# Reference: GABLS1 (GEWEX Atmospheric Boundary Layer Study 1)
# Beare et al. (2006): An intercomparison of large-eddy simulations of the stable 
# boundary layer. Boundary-Layer Meteorol., 118, 247-272.
#
# Stable conditions characterized by:
#   - Strong negative surface heat flux (cooling)
#   - Statically stable stratification (dθ/dz > 0)
#   - Weak mixing and oscillatory motion
#   - Inertial oscillations due to Coriolis (geostrophic wind balance)
#   - Sharp PBL-free atmosphere interface
#   - Very limited vertical mixing (low diffusivity)
#
# This case tests MRF performance in stable conditions where:
# - Countergradient corrections have minimal effect (HGAMT → 0)
# - Stability damping dominates (φ_M, φ_T large, reducing K)
# - Richardson number mixing is weak in PBL (Ri-dependent K)
# - Free atmosphere mixing via YSU scheme becomes important
# - Accurate prediction of very shallow PBL is critical

erf.prob_name = "ABL"

stop_time = 28800.0  # 8 hours

amrex.fpe_trap_invalid = 1

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY (from GABLS1)
# Coarse resolution acceptable due to weak turbulence
geometry.prob_extent =  400     400     400
amr.n_cell           =  64      64      64

geometry.is_periodic = 1 1 0

# MOST BOUNDARY - Strong surface cooling
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m] (from Beare et al. 2006)
erf.most.zref = 10.0     # reference height [m]
erf.most.surf_temp = 265.0      # surface temperature [K] (very cold)
erf.most.surf_heating_rate = -0.25  # strong cooling rate [K/h] (from Beare et al. 2006)

# Upper boundary - capping inversion
zhi.type = "SlipWall"
zhi.theta_grad = 0.01   # strong stable layer [K/m] (from Beare et al. 2006)

# TIME STEP CONTROL
erf.fixed_dt = 0.05  # time step [s] - can be larger due to weak dynamics

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# planar averaging (important for stable case diagnostics)
erf.data_log    = stable_hist.dat stable_profiles.dat stable_covar.dat
erf.profile_int = 20

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk_stable      # root name of checkpoint file
erf.check_int       = 1200            # number of timesteps between checkpoints

# PLOTFILES
erf.plot_file_1     = plt_stable       # prefix of plotfile name
erf.plot_int_1      = 200              # number of timesteps between plotfiles
erf.plot_vars_1     = density x_velocity y_velocity z_velocity pressure theta

# SOLVER CHOICE
erf.use_gravity = true

erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

erf.molec_diff_type = "None"
erf.les_type  = "Deardorff"
erf.Ck        = 0.1
erf.sigma_k   = 1.0
erf.Ce        = 0.1
erf.theta_ref = 270.0

# INITIALIZATION - Stable conditions (from GABLS1 input_sounding)
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding_GABLS1"

# PROBLEM PARAMETERS (initial values if Uniform initialization used)
prob.rho_0 = 1.3   # polar air density [kg/m³]
prob.A_0 = 1.0

prob.U_0 = 8.0       # geostrophic wind speed [m/s]
prob.V_0 = 0.0       # no cross-wind component initially
prob.W_0 = 0.0       # no mean vertical motion
prob.T_0 = 270.0     # cold base temperature [K]

# Weak perturbations (stable case suppresses turbulence)
prob.U_0_Pert_Mag = 0.1
prob.V_0_Pert_Mag = 0.1
prob.W_0_Pert_Mag = 0.01

# PBL CONFIGURATION - MRF for stable boundary layer
erf.pbl_type    = "mrf"
pbl.pbl_mrf_Ribcr = 0.5   # critical bulk Richardson number
pbl.pbl_mrf_const_b = 7.8 # surface layer factor (WRF CFAC)
pbl.pbl_mrf_sf = 0.1      # surface layer fraction (WRF SFAC)

# DISABLE COUNTERGRADIENT CORRECTIONS (not applicable for stable conditions)
# In stable PBL, flux gradients are downgradient (no countergradient term)
pbl.enable_mrf_countergradient = false

# Disable moisture diffusivity (dry stable case from GABLS1)
pbl.mrf_moistvars = false

# CORIOLIS EFFECT - High latitude for strong inertial oscillations
erf.latitude = 73.3  # GABLS1 latitude near Cabauw, Netherlands
