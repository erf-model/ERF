# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Diurnal Cycle Transition Test (Wangara or GABLS2)
#
# A continuous 24-to-48-hour simulation driven by a time-varying surface temperature
# or sensible heat flux boundary condition.
#
# Why it is needed:
# Boundary layer transition phases (afternoon decay and morning growth) are highly
# challenging for nonlocal schemes. Testing this cycle validates that the sign
# transitions of the Monin-Obukhov length L and the subsequent activation/deactivation
# of the countergradient terms (HGAMT/HGAMQ) occur smoothly without producing
# spurious numerical oscillations.
#
# This test validates MRF under dynamic transition between stable and unstable regimes.

erf.prob_name = "ABL"

max_step = 20

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
geometry.prob_extent = 8000  8000  2048
amr.n_cell           =  8   8   64
geometry.is_periodic = 1 1 0

# MOST BOUNDARY WITH DIURNAL CYCLE CAPABILITY
zlo.type = "surface_layer"
erf.most.z0   = 0.1
erf.most.zref = 48.0

# Diurnal temperature cycle parameters:
# Start with neutral, then heat, then cool
erf.most.surf_temp = 295.0
erf.most.surf_heating_rate = 1.0  # Dynamic heating rate [K/h] to trigger transition

zhi.type = "SlipWall"
zhi.theta_grad = 0.003  # adiabatic upper boundary


# TIME STEP CONTROL
erf.fixed_dt = 0.1  # fixed time step depending on grid resolution

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk_diurnal
erf.check_int       = 100


# PLOTFILES
erf.plot_file_1     = plt_unstable      # prefix of plotfile name
erf.plot_int_1      = 15                # number of timesteps between plotfiles
erf.plot_vars_1     = density rhoadv_0 rhoadv_1 x_velocity y_velocity z_velocity pressure temp theta

# SOLVER CHOICE
erf.use_gravity = true

erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.Cs = 0.11
erf.theta_ref = 300.0

# INITIALIZATION - from sounding file
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding_MRF_diurnal"

# PBL CONFIGURATION - MRF PBL with transition-capable countergradient
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.mrf_moistvars = true

# PROBLEM PARAMETERS


# Perturbations to trigger transition turbulence

# CORIOLIS EFFECT
erf.latitude = 45.0  # mid-latitude (f = 1.0e-4 s^-1)

erf.use_coriolis = true

erf.abl_driver_type = "GeostrophicWind"

erf.abl_geo_wind = 8.0 0.0 0.0
