# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Weak Convection Transition Test Case
# 
# Reference: Morning transition from neutral to weakly convective boundary layer
# This test validates the smooth activation of countergradient fluxes (HGAMT/HGAMQ)
# without spurious oscillations as surface heating gradually increases.
#
# Physical Context:
#   - Pre-dawn transitional period to morning convection (very common scenario)
#   - Tests numerical stability of HGAMT/HGAMQ activation mechanism
#   - Validates that countergradient corrections smoothly transition from 0 to positive values
#   - Key physics: PBL height should grow monotonically without abrupt jumps
#
# This case is critical for:
# - Validating smooth activation of countergradient terms (not negative values)
# - Testing Richardson number behavior during stability transitions
# - Ensuring PBL height evolution is physical and monotonic
# - Catching oscillations in Monin-Obukhov length calculations

erf.prob_name = "ABL"

# 24-hour simulation: 21600 s
# With dt=0.1, max_step = 216000
max_step = 216000

amrex.fpe_trap_invalid = 1

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
# Moderate resolution suitable for transitional dynamics
geometry.prob_extent =  2048     2048    1536
amr.n_cell           =    64       64      64

geometry.is_periodic = 1 1 0

# MOST BOUNDARY - Time-varying surface heating (weak convection transition)
# Heat flux increases gradually from 0 K/h (night) to 2 K/h (weak morning convection)
# This mimics realistic pre-dawn warming: starts neutral, becomes weakly unstable
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m]
erf.most.zref = 10.0     # reference height [m]
erf.most.surf_temp = 300.0   # initial surface temperature [K]
erf.most.surf_heating_rate = 0.5  # average heating rate [K/h] (varies with time)

# Upper boundary - stable layer
zhi.type = "SlipWall"
zhi.theta_grad = 0.005   # weak stable layer [K/m] (typical for tropical mornings)

# TIME STEP CONTROL
erf.fixed_dt = 0.1  # time step [s]

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# Planar averaging for profile diagnostics
erf.data_log    = transition_hist.dat transition_profiles.dat
erf.profile_int = 50  # frequent profiles to capture transition

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk_weak_convection    # root name of checkpoint file
erf.check_int       = 50000                  # checkpoint every ~5400 s (90 min)

# PLOTFILES
erf.plot_file_1     = plt_weak_convection     # prefix of plotfile name
erf.plot_int_1      = 10000                   # plotfile every 1000 s (~16 min)
erf.plot_vars_1     = density rhoadv_0 rhoadv_1 x_velocity y_velocity z_velocity pressure temp theta

# SOLVER CHOICE
erf.use_gravity = true

erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.theta_ref = 300.0

erf.init_type = Uniform

# INITIALIZATION - Start from neutral conditions
# Neutral profile (uniform θ) transitioning to weakly convective
prob.rho_0 = 1.225   # sea level air density [kg/m³]
prob.A_0 = 1.0       # stretching factor

prob.U_0 = 8.0       # mean wind speed [m/s] (typical for weak convection)
prob.V_0 = 0.0       # no cross-wind
prob.W_0 = 0.0       # no mean vertical motion
prob.T_0 = 300.0     # initial uniform potential temperature [K]

# Small perturbations to trigger turbulence development
prob.U_0_Pert_Mag = 0.4
prob.V_0_Pert_Mag = 0.4
prob.W_0_Pert_Mag = 0.1

# PBL CONFIGURATION - MRF with countergradient enabled (tests smooth activation)
erf.pbl_type    = "mrf"
pbl.pbl_mrf_Ribcr = 0.5   # critical bulk Richardson number
pbl.pbl_mrf_const_b = 7.8 # surface layer factor (WRF CFAC)
pbl.pbl_mrf_sf = 0.1      # surface layer fraction (WRF SFAC)

# Enable countergradient corrections - THIS IS THE KEY TEST
# The correction should activate smoothly as heat flux increases
pbl.enable_mrf_countergradient = true

# Enable moisture diffusivity (optional)
pbl.mrf_moistvars = false

# CORIOLIS EFFECT
erf.latitude = 45.0  # mid-latitude (f = 1.0e-4 s^-1)

# END OF INPUT FILE
