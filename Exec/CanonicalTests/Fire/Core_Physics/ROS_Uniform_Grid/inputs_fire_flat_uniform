# Check uniform-grid fire spread consistency.
#
# This case verifies that fire spread on a flat, uniform grid behaves consistently with the analytical/unit-test benchmark. It is useful for separating physics verification from mesh or terrain complications.
#
# Expected result:
#   - Front propagation rate agrees with the expected uniform-grid benchmark.
#   - No spurious directional bias appears from the mesh layout.
#
# Configuration:
#   - Flat domain and uniform cell spacing.
#   - Simple ignition and baseline fire parameters isolate numerical consistency.
#
# Notes:
#   - Related Python regression checks in this directory provide an additional reference.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell       = 40 40 50

geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size   = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
erf.most.z0 = 0.1
zhi.type = "SlipWall"

erf.init_type   = "uniform"
erf.theta_ref   = 300.0
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.use_gravity = true

erf.fixed_dt  = 1.0
stop_time     = 1800.0
max_step      = 100

erf.sum_interval = 10
erf.v   = 1
amr.v   = 1

erf.check_file  = chk_flat
erf.check_int   = -1

# Plot files (2D fire variables on fire grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 100


erf.fire.enable         = true
erf.fire.fire_debug     = true
erf.fire.grid_ratio     = 5
erf.fire.fuel_model_id  = 1
erf.fire.moisture_1hr   = 0.08
erf.fire.moisture_10hr  = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.ignition_x     = 1000.0
erf.fire.ignition_y     = 1000.0
erf.fire.ignition_r     = 50.0
erf.fire.wind_ref_ht    = 6.1
erf.fire.use_waf        = true
erf.fire.waf_formula    = "andrews"
erf.fire.use_wind_limit = false
erf.fire.use_terrain_wind = false
