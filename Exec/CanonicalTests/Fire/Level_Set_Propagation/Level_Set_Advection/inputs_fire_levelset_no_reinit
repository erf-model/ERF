# Level-set advection with reinitialization disabled.
#
# Isolates the WENO5-Z + SSP-RK3 advection from the signed-distance
# reinitialization, so a regression can be attributed to one or the other.
#
# Expected result (measured, 1 rank, 600 s):
#   Burned-cell count at t = 150 / 300 / 450 / 600 s
#     analytic                     34 /  41 /  48 /  56
#     this case                    32 /  44 /  52 /  52
#     with reinitialization        36 /  52 /  60 /  64
#   - Advection alone already tracks the analytic front closely over this
#     duration, because initialize_ignition hands the level-set path a true
#     signed distance and the advection roughly preserves it.
#   - phi_max grows to about the far-corner distance, as a signed distance
#     should; it is not clamped.
#   - Thread-independent: 32/44/52/52 at both 1 and 4 OpenMP threads. The
#     baseline case is not, which is what localises that defect to the
#     reinitialization.
#
# Notes:
#   - Reinitialization still matters for longer runs and for fronts that merge
#     or develop kinks, where |grad phi| degrades away from 1. This case is the
#     control, not a recommendation to leave it off.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 600.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_levelset_no_reinit_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_levelset_no_reinit.csv"

# ---------------------------------------------------------------------------
# Level-set propagation, reinitialization-heavy
# ---------------------------------------------------------------------------
erf.fire.propagation_method = "levelset"
erf.fire.levelset.cfl = 0.25
erf.fire.levelset.eps_visc = 0.2
erf.fire.levelset.reinit_every = 1000000  # disabled: this case isolates the advection
erf.fire.levelset.reinit_iters = 100
erf.fire.levelset.reinit_dtau = 2.0
