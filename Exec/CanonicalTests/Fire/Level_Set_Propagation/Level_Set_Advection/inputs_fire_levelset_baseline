# Level-set fire-front propagation (WENO5-Z + SSP-RK3).
#
# Exercises the PDE-based alternative to the default FARSITE Lagrangian path.
# The level set is advanced with a Godunov-norm gradient, WENO5-Z reconstruction
# and a three-stage SSP-RK3 step, subcycled on its own CFL condition.
#
# Expected result:
#   - The run completes with propagation_method = "levelset".
#   - The burned area grows monotonically and phi stays within [-1, 1].
#     Measured at the 100 s stop time: phi in [-0.84, 1.0], 34 burned cells.
#   - No box-boundary artefacts appear in the level set: the RK3 stages fill
#     ghost cells before every WENO5-Z reconstruction.
#
# Configuration:
#   - Same geometry, fuel and ignition as the Rothermel baseline so the two
#     propagation methods can be compared directly.
#   - Signed-distance reinitialization is DISABLED here. It no longer diverges,
#     but it still erodes the front (see inputs_fire_levelset_reinit_erosion),
#     so the advection scheme is baselined without it.
#   - The run stops at 100 s deliberately. Without reinitialization phi's
#     magnitude drifts: measured phi_min is -0.84 at 100 s, -1.57 at 300 s and
#     -3.40 at 600 s. The sign stays correct throughout, and the sign is all the
#     rest of the module reads, but past ~100 s the [-1, 1] normalization no
#     longer holds. Keeping reinitialization is what would bound it.
#
# Notes:
#   - Level-set propagation is isotropic: it advances the front at the scalar
#     ROS through a Godunov norm and does not use the wind direction, so the
#     perimeter stays near-circular even under wind. Compare against
#     FARSITE_Propagation/Elliptical_Propagation for the elliptical treatment.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 100.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_levelset_baseline_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_levelset_baseline.csv"

# ---------------------------------------------------------------------------
# Level-set propagation
# ---------------------------------------------------------------------------
erf.fire.propagation_method = "levelset"
erf.fire.levelset.cfl = 0.4              # subcycle CFL; must be > 0
erf.fire.levelset.eps_visc = 0.4         # artificial viscosity on the Laplacian
erf.fire.levelset.reinit_every = 1000000  # disabled: reinitializer is divergent, see README
erf.fire.levelset.reinit_iters = 10      # Sussman pseudo-time iterations
erf.fire.levelset.reinit_dtau = -1.0     # <= 0 selects 0.5*min(dx,dy)
