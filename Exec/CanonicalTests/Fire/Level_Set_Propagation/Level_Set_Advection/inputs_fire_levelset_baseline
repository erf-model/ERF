# Level-set fire-front propagation (WENO5-Z + SSP-RK3, signed distance).
#
# Exercises the PDE-based alternative to the default FARSITE Lagrangian path.
# phi is a true signed distance in metres for this path: negative inside the
# burned region, positive outside, |grad phi| = 1. The FARSITE path keeps its
# own normalized [-1, 1] indicator convention.
#
# Expected result (measured, 1 rank, OMP_NUM_THREADS=1, 600 s):
#   Burned-cell count at t = 150 / 300 / 450 / 600 s
#     analytic (r = r0 + R*t)      34 /  41 /  48 /  56
#     this case                    36 /  52 /  60 /  64
#     FARSITE reference            32 /  32 /  32 /  68
#
# Deterministic: repeat runs agree exactly, and the case is clean under
# amrex.init_snan=1 amrex.fpe_trap_invalid=1. It was neither until the fire
# Geometry was given the atmospheric periodicity; before that every
# FillBoundary on the fire grid was a no-op and the WENO5-Z stencil read
# uninitialized memory three cells past the box edge.
#
# Configuration:
#   - Reinitialization every 5 subcycles with 100 iterations.
#   - The iteration count matters. Reinitialization propagates information about
#     n_iters * dtau metres per call, so 10 iterations only reaches ~25 m here
#     and leaves the field short of a signed distance further out, which shows
#     up as the front over-spreading: 122 cells at 600 s instead of 64.
#
# Notes:
#   - Level-set propagation is isotropic: it advances the front at the scalar
#     ROS through a Godunov norm and does not use wind direction, so the
#     perimeter stays near-circular even under wind. Compare against
#     FARSITE_Propagation/Elliptical_Propagation for the elliptical treatment.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 600.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_levelset_baseline_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_levelset_baseline.csv"

# ---------------------------------------------------------------------------
# Level-set propagation
# ---------------------------------------------------------------------------
erf.fire.propagation_method = "levelset"
erf.fire.levelset.cfl = 0.4              # subcycle CFL; must be > 0
erf.fire.levelset.eps_visc = 0.4         # artificial viscosity on the Laplacian
erf.fire.levelset.reinit_every = 5        # reinitialize every N subcycles; must be >= 1
erf.fire.levelset.reinit_iters = 100      # must converge over the burn; see header
erf.fire.levelset.reinit_dtau = -1.0     # <= 0 selects 0.5*min(dx,dy)
