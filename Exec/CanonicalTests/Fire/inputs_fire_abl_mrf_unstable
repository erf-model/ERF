# ABL with MRF boundary layer parametrization and fire model
# This test case couples the Mesoscale Radiation Framework (MRF) for the
# atmospheric boundary layer with the wildfire propagation model.

stop_time = 512

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
geometry.prob_extent = 8000  8000  2048
amr.n_cell           =  20   20   64

geometry.is_periodic = 1 1 0
erf.initial_dz = 4.0
erf.grid_stretching_ratio = 1.06

# MOST BOUNDARY (DEFAULT IS ADIABATIC FOR THETA)
zlo.type = "surface_layer"
erf.most.z0                 = 0.1
erf.most.surf_temp_flux    = 0.24
erf.most.zref = 10

zhi.type        = "SlipWall"
zhi.theta_grad  = 0.003

# INITIALIZATION
erf.init_type           = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "mrf_sounding_unstable"

# TIME STEP CONTROL
erf.cfl = 0.25
erf.substepping_cfl = 0.5

# DIAGNOSTICS & VERBOSITY
erf.sum_interval    = 1
erf.v               = 1
amr.v               = 1

# REFINEMENT / REGRIDDING
amr.max_level       = 0

# CHECKPOINT FILES
erf.check_file      = chk
erf.check_int       = -1

# PLOTFILES
# FIRE PLOTFILE (on native fire grid, C x finer than atmospheric grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 10

# DATA COLLECTION
erf.data_log        = surf_hist.dat mean_profiles.dat flux_profiles.dat sfs_profiles.dat
erf.profile_int     = 1000
erf.destag_profiles = false

# SOLVER CHOICE
erf.dycore_vert_adv_type   = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

erf.molec_diff_type = "None"

erf.use_gravity = true

# Coriolis parameter
erf.use_coriolis = true
erf.latitude = 45.0
erf.rotational_time_period = 86455.2516813368

# Geostrophic wind
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0

# Turbulence closure
erf.les_type    = "None"
erf.pbl_type    = "MRF"
erf.pbl_mrf_coriolis_freq = 1e-4
erf.pbl_mrf_Ribcr = 0.5

# Rayleigh damping
erf.rayleigh_damp_U = true
erf.rayleigh_damp_V = true
erf.rayleigh_damp_T = true
erf.rayleigh_damp_W = true
erf.rayleigh_zdamp = 512
erf.rayleigh_dampcoef = 0.05

# FIRE MODEL PARAMETERS
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 4              # Fire grid is 2x finer than atmospheric grid
erf.fire.fuel_model_id = 1            # GR1 (Short grass) Anderson FBFM13 model
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.ignition_x = 4000.0
erf.fire.ignition_y = 4000.0
erf.fire.ignition_r = 400.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false     # Flat domain
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3
