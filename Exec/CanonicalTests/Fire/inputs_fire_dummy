# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Dummy inputs for 2D fire model test

erf.prob_name = "Fire"

# Run for just a few time steps for testing
max_step = 10

# Domain and grid
geometry.prob_extent = 1000.0 1000.0 500.0
amr.n_cell = 32 32 16

geometry.is_periodic = 0 0 0

# Boundary conditions
xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "SlipWall"
zhi.type = "SlipWall"

# Time step
erf.fixed_dt = 1.0

# Diagnostics
erf.sum_interval = 1
erf.v = 1
