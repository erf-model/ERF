# Phase 13 regression test: Per-fuel wind height extraction (Phase 13A).
# Domain: 2 km x 2 km flat, FM1 (short grass), 5 m/s geostrophic wind.
# Ignition at (1000, 1000), radius 30 m, passive coupling, no acceleration.
# Uses default Rothermel ROS model.
#
# Enables per-fuel wind height extraction via use_per_fuel_wind_ht = true.
# Per-fuel `fcwh` values and `fcz0` roughness lengths are applied in the
# WAF (Wind Adjustment Factor) computation.
#
# Expected checks:
#   1. [FIRE DEBUG] output reports per-fuel wind height computation.
#   2. fire_extract_z plotfile field contains the per-fuel extraction height.
#   3. fire_ros is consistent with Rothermel model.
#   4. No NaN or abort.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_per_fuel_wind_ht_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_per_fuel_wind_ht = true
erf.fire.waf_fcz0_scale = 1.0
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_phase13_per_fuel_wind_ht.csv"
