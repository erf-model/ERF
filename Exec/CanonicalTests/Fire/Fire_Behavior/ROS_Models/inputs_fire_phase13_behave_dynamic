# BEHAVE rate of spread driven by per-cell fuel moisture.
#
# The per-cell path: with moisture_dynamic = true the BEHAVE state is rebuilt
# for every cell from that cell's five moisture components rather than from a
# single domain-wide state. This is the branch that exercises live herbaceous
# fuel transfer.
#
# Expected result:
#   - Spread rate varies across the domain as fuel moisture responds to the
#     atmosphere, where the uniform-moisture case is spatially flat.
#   - Values stay physically bounded; no cell shows a spread rate unrelated to
#     its own moisture. Per-cell state is evaluated inside the ROS kernel, so a
#     cell reading another cell's coefficients would show up here.
#
# Configuration:
#   - ros_model = "behave" with moisture_dynamic = true.
#   - dynamic_transfer_lo/hi bracket the live herbaceous moisture range over
#     which live fuel is transferred to the dead herbaceous class.
#
# Notes:
#   - Compare against inputs_fire_phase13_behave to isolate the per-cell path.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_phase13_behave_dynamic_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = true
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "behave"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_phase13_behave_dynamic.csv"

# ---------------------------------------------------------------------------
# BEHAVE live herbaceous transfer window
# ---------------------------------------------------------------------------
erf.fire.moisture_live = 0.90
erf.fire.behave.dynamic_transfer_lo = 0.30   # full transfer below this live moisture
erf.fire.behave.dynamic_transfer_hi = 1.20   # no transfer above it
