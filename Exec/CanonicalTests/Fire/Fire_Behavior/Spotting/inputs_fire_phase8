# Phase 8 regression test: Albini (1983) ember spotting.
# Domain: 2 km x 2 km x 500 m, flat, FM4 (Chaparral), 8 m/s wind, 8% moisture.
# FM4 produces high fireline intensity (I_B >> 100 kW/m) to trigger spotting.
# 15-minute simulation (900 s).
#
# Expected output checks (manual verification):
#   1. fire_stats_phase8.csv contains non-zero spot_fires_this_step and
#      max_spot_dist_m after t > 60 s (fire has grown past threshold intensity).
#   2. fire_spot_active plotfile field shows isolated phi-negative patches
#      downwind of the main fire at t = 900 s.
#   3. With random_seed = 42: two identical runs produce identical spotting locations.
#   4. With spotting.enable = false: spot_fires_this_step = 0 throughout.
#   5. No NaN or abort.
#
# ParmParse keys validated against ERF_FireParams.H:
#   erf.fire.spotting.enable, spotting.I_B_min, spotting.P_base,
#   spotting.terminal_velocity, spotting.n_traj_steps, spotting.spot_radius,
#   spotting.P_catch, spotting.random_seed, spotting.spotting_interval,
#   spotting.fuel_system
#
# CSV output columns: step, time_s, burned_area_ha, perimeter_km,
#   active_front_cells, head_ros_ms, major_axis_m, minor_axis_m,
#   heat_flux_max_Wm2, spot_fires_this_step, max_spot_dist_m

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta u v

erf.fire.enable             = true
erf.fire.fire_debug         = false
erf.fire.grid_ratio         = 5
erf.fire.fuel_model_id      = 4
erf.fire.moisture_1hr       = 0.08
erf.fire.moisture_10hr      = 0.08
erf.fire.moisture_100hr     = 0.10
erf.fire.moisture_dynamic   = false
erf.fire.ignition_x         = 500.0
erf.fire.ignition_y         = 1000.0
erf.fire.ignition_r         = 30.0
erf.fire.use_terrain_wind   = false
erf.fire.farsite.cfl_fire   = 0.5
erf.fire.coupling_type      = "passive"

# Phase 8: Albini (1983) ember spotting parameters
erf.fire.spotting.enable             = true
erf.fire.spotting.I_B_min            = 100.0
erf.fire.spotting.P_base             = 0.05
erf.fire.spotting.terminal_velocity  = 0.5
erf.fire.spotting.n_traj_steps       = 20
erf.fire.spotting.spot_radius        = 15.0
erf.fire.spotting.P_catch            = 1.0
erf.fire.spotting.random_seed        = 42
erf.fire.spotting.spotting_interval  = 5
erf.fire.spotting.fuel_system        = "13"

erf.fire.write_fire_stats_csv = true
erf.fire.fire_stats_csv_file  = "fire_stats_phase8.csv"
