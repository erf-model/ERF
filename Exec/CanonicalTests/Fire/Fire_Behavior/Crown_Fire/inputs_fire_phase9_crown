# Phase 9 regression test: crown fire initiation plus flame temperature / tilt diagnostics.
# Domain: 2 km x 2 km x 500 m, FM8 timber litter, lagged coupling, 10 m/s background wind.
# Van Wagner configuration: C_BH=5.0 m, M_fold=1.00, M_c=0.30.
# Expected Cruz active crown ROS for U_10=30 km/h and CBD=0.20: about 15-45 m/min.
# Expected checks:
#   1. crown_fire_cells > 0 after the head fire intensifies beyond the initiation threshold.
#   2. fire_crown_fraction_burned increases in the advancing head-fire region.
#   3. fire_flame_tilt and fire_flame_temp are non-zero in burned cells.
#   4. fire_debug output reports stable Phase 9 diagnostics without NaNs or aborts.
#
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 10.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 8
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "lagged"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = true
erf.fire.flame_tilt_T_amb = 300.0
erf.fire.flame_tilt_rho_air = 1.2

erf.fire.crown.canopy_base_ht = 5.0
erf.fire.crown.canopy_bulk_den = 0.20
erf.fire.crown.canopy_depth = 10.0
erf.fire.crown.foliar_moisture = 1.00
erf.fire.crown.M_c = 0.30
erf.fire.crown.h_crown_BTU_lb = 8000.0
erf.fire.crown.wind_10m_kmh = 30.0
erf.fire.crown.ros_model = "cruz"
erf.fire.crown.use_passive_blend = false
erf.fire.crown.enable = true
erf.fire.fire_stats_csv_file = "fire_stats_phase9_crown.csv"
