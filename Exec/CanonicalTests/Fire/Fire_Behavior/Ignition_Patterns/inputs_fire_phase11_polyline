# Phase 11 regression test: polyline-based line fire ignition.
# Domain: 2 km x 2 km x 500 m, FM1 (short grass), lagged coupling, 5 m/s wind.
# Polyline ignition creates an east-west line fire; spreads north/south from the line.
# Polyline half-width set to 20 m (covers grid cells within 20 m of the line).
# Primary point ignition disabled by setting ignition_r = 0.
# Expected checks:
#   1. At t=0: fire_phi shows a band of burned cells (width ~40 m) along y=1000 m from x=400 to x=1600 m.
#   2. Fire spreads perpendicular to the line (north/south); main propagation along the line too.
#   3. No NaN or abort; [FIRE DEBUG] output confirms polyline ignition applied.
#   4. Burned area increases as fire spreads from the line in both directions.
#   5. fire_ros shows directional bias based on wind (5 m/s in +x direction).

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 100
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_
erf.fire_plot_int = 100

# Fire module parameters - polyline-based line fire
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5                           # 10 m × 10 m fire cells
erf.fire.fuel_model_id = 1                        # FM1 (Short grass)
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
# Disable point ignition in favor of polyline
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 0.0
# Polyline ignition from file
erf.fire.ignition.polygon_file = "Supporting_Files/polyline_phase11.csv"
erf.fire.ignition.polygon_type = "polyline"
erf.fire.ignition.polyline_width = 20.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3
