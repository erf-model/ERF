# Phase 11 regression test: polygon-based initial fire perimeter.
# Domain: 2 km x 2 km x 500 m, FM1 (short grass), lagged coupling, 5 m/s wind.
# Polygon ignition from vertex file creates elliptical initial burn area.
# Primary point ignition disabled by setting ignition_r = 0.
# Expected checks:
#   1. At t=0: fire_phi shows ellipse-shaped burned region matching polygon_phase11.csv vertices.
#   2. Fire spreads outward from polygon boundary; no isolated interior burn.
#   3. Perimeter of ellipse is the fire front; fire_ros shows outward propagation.
#   4. No NaN or abort; [FIRE DEBUG] output confirms polygon ignition applied.
#   5. Burned area increases as fire spreads from polygon boundary.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 100
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_
erf.fire_plot_int = 100

# Fire module parameters - polygon-based initial perimeter
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5                           # 10 m × 10 m fire cells
erf.fire.fuel_model_id = 1                        # FM1 (Short grass)
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
# Disable point ignition in favor of polygon
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 0.0
# Polygon ignition from file
erf.fire.ignition.polygon_file = "Supporting_Files/polygon_phase11.csv"
erf.fire.ignition.polygon_type = "polygon"
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3
