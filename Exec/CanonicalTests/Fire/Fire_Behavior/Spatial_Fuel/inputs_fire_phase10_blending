# Phase 10 regression test: Fuel boundary blending for smooth ROS transition.
# Domain: 2 km x 2 km x 500 m, two-zone fuel map (FM1 south, FM4 north at y=1000 m).
# Atmosphere: 40 x 40 x 50 cells, passive coupling, 5 m/s geostrophic wind.
# Fire grid: 200 x 200 cells at 10 m resolution (grid_ratio=5).
# Ignition: centre (500, 200) m, radius 30 m.
# Blending fraction: 0.2 (ROS smoothing at zone boundary).
# Purpose: Verify blending_fraction > 0 produces smooth ROS transition at
#   fuel zone boundaries, reducing discontinuities compared to zero blending.
# Expected checks:
#   - fire_ros plotfile shows smoother transition at y=1000 m than zero-blending case
#   - Transition band spans multiple cells at FM1/FM4 interface
#   - No NaN values or simulation abort
#   - Perimeter growth similar to zero-blending case (same ignition, wind)

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = false
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 200.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true

erf.fire.fuel_map.file = "./fuel_map_phase10_200x200.asc"
erf.fire.fuel_map.format = "ascii"
erf.fire.fuel_map.blending_fraction = 0.2

erf.fire.fire_stats_csv_file = "fire_stats_phase10_blending.csv"
