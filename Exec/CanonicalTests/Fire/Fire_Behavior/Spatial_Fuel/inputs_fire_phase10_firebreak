# Phase 10 regression test: Firebreak barrier preventing fire crossing.
# Domain: 2 km x 2 km x 500 m, uniform FM1 fuel, lagged coupling, 5 m/s wind.
# Fire grid: 200 x 200 cells at 10 m resolution (grid_ratio=5).
# Ignition: centre (300, 1000) m, radius 30 m.
# Firebreak: rectangular barrier at x in [800, 900] m, spanning full y-extent.
# Purpose: Verify firebreak barriers prevent fire propagation and phi remains
#   at sentinel value within barrier zone.
# Expected checks:
#   - phi values in firebreak band equal FIREBREAK_PHI_SENTINEL (1.0e6)
#   - No burned cells east of barrier at stop_time
#   - Burned area on west side of barrier, zero on east side
#   - No NaN values or simulation abort

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.geostrophic_wind_x = 5.0
erf.geostrophic_wind_y = 0.0

erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta qv u v w
erf.fire_plot_file = plt_fire_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 300.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true

erf.fire.fuel_map.file = "./fuel_map_phase10_firebreak.asc"
erf.fire.fuel_map.format = "ascii"
erf.fire.fuel_map.blending_fraction = 0.0

erf.fire.firebreak.0.type = "rect"
erf.fire.firebreak.0.x_lo = 800.0
erf.fire.firebreak.0.x_hi = 900.0
erf.fire.firebreak.0.y_lo = 0.0
erf.fire.firebreak.0.y_hi = 2000.0

erf.fire.fire_stats_csv_file = "fire_stats_phase10_firebreak.csv"
