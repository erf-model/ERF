# Phase 2 ERF-Fire Regression Test
# Flat domain, GR1 fuel, 5 m/s wind, 8% moisture

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

# Domain periodicity
geometry.is_periodic = 0 0 0

# No AMR
amr.max_level = 0

# Max grid size (REQUIRED for fire: no z-decomposition)
amr.max_grid_size = 100
amr.max_grid_size_z = 50

# Surface layer boundary condition (REQUIRED for fire)
erf.phys_bc_type.zlo = "surface_layer"
erf.phys_bc_type.zhi = "SlipWall"

# MOST parameters (REQUIRED for fire wind extraction)
erf.most.z0 = 0.1

# Physics
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"

# Initial conditions
erf.init_type = "uniform"
erf.theta_ref = 300.0

# Time stepping
erf.fixed_dt = 1.0
stop_time = 1800.0
max_step = 2000

# Diagnostics
erf.sum_interval = 100
erf.v = 1
amr.v = 1

# Checkpoints/Plots
erf.check_file = fire_chk
erf.check_int = -1
erf.plot_file_1 = fire_plt
erf.plot_int_1 = 100
erf.plot_vars_1 = density rhoadv_0 x_velocity y_velocity z_velocity pressure temp theta

# Fire module parameters (Phase 2)
erf.fire.enable = true
erf.fire.grid_ratio = 5              # 10 m × 10 m fire cells (5 times finer than 50 m atm)
erf.fire.fuel_model_id = 1            # GR1 (Short grass) Anderson FBFM13 model
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 20.0
erf.fire.wind_ref_ht = 6.1            # Reference height [m]
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false     # Flat domain
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3
