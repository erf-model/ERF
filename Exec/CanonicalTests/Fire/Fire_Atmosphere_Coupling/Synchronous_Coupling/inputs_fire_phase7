# Phase 7 regression test: synchronous coupling.
# Fire advances using post-dycore wind (vars_new) each step.
# Domain: 2 km x 2 km, flat, GR1 fuel, 5 m/s wind, 8% moisture, 30 min.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1

erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0

erf.fixed_dt = 1.0
stop_time = 1800.0
max_step = 2000

erf.sum_interval = 100
erf.v = 1
amr.v = 1
erf.check_int = -1

# Plot files (2D fire variables on fire grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 100

# Plot files (3D atmospheric variables)
erf.plot_int = 100
erf.plot_vars = theta u v w

# Plot files (2D fire variables only - separate from atmospheric due to different grid)
erf.plot2d_file_1 = plt2d_fire
erf.plot2d_int_1 = 100

# Plot files (2D fire variables at final time step)
erf.plot2d_file_2 = plt2d_fire_final
erf.plot2d_int_2 = -1
erf.plot2d_vars_2 = fire_phi fire_ros fire_wind_eff fire_wind_ref fire_slopes fire_fuel_mc fire_tsurf fire_fuel_burned fire_ignition_mask

erf.fire.enable             = true
erf.fire.fire_debug         = false
erf.fire.grid_ratio         = 5
erf.fire.fuel_model_id      = 1
erf.fire.moisture_1hr       = 0.08
erf.fire.moisture_10hr      = 0.08
erf.fire.moisture_100hr     = 0.10
erf.fire.moisture_dynamic   = false
erf.fire.ignition_x         = 1000.0
erf.fire.ignition_y         = 1000.0
erf.fire.ignition_r         = 20.0
erf.fire.use_terrain_wind   = false
erf.fire.farsite.cfl_fire   = 0.5

# Phase 7: synchronous coupling
erf.fire.coupling_type      = "synchronous"
erf.fire.heat_flux_alfg     = 45.0
erf.fire.fire_atm_feedback  = 1.0
erf.fire.inject_latent      = true

erf.fire.write_fire_stats_csv = true
erf.fire.fire_stats_csv_file  = "fire_stats_phase7.csv"
