# Phase 6 ERF-Fire Regression Test: one-way fire-atmosphere coupling
# with WRF-Fire-style exponential heat distribution and latent heat injection.
# Flat domain, GR1 fuel, 5 m/s wind, 8% moisture, 30 min runtime.
# Expected output: theta anomaly above burned area increases with latent heat response.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

# Domain periodicity
geometry.is_periodic = 0 0 0

# No AMR
amr.max_level = 0

# Max grid size (REQUIRED for fire: no z-decomposition)
amr.max_grid_size = 100
amr.max_grid_size_z = 50

# Surface layer boundary condition (REQUIRED for fire)
xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"

# MOST parameters (REQUIRED for fire wind extraction)
erf.most.z0 = 0.1

# Physics
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"

# Initial conditions
erf.init_type = "uniform"
erf.theta_ref = 300.0

# Time stepping
erf.fixed_dt = 1.0
stop_time = 1800.0
max_step = 2000

# Diagnostics
erf.sum_interval = 100
erf.v = 1
amr.v = 1

# Checkpoints/Plots
erf.check_int = -1

# Plot files (2D fire variables only)
erf.plot2d_file_1 = plt2d_fire_phase6
erf.plot2d_int_1 = 100

# Plot files (2D fire variables at final time step)
erf.plot2d_file_2 = plt2d_fire_final
erf.plot2d_int_2 = -1
erf.plot2d_vars_2 = fire_phi fire_ros fire_wind_eff fire_wind_ref fire_slopes fire_fuel_mc fire_tsurf fire_fuel_burned fire_ignition_mask
erf.plot2d_vars_1 = fire_phi fire_ros fire_wind_eff fire_fuel_mc fire_heat_flux fire_fuel_load fire_fireline_intensity fire_flame_length

# Plot files (3D atmospheric variables)
erf.plot_int = 100
erf.plot_vars = theta qv u v w

# Fire module parameters
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5              # 10 m × 10 m fire cells (5 times finer than 50 m atm)
erf.fire.fuel_model_id = 1            # GR1 (Short grass) Anderson FBFM13 model
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 20.0
erf.fire.wind_ref_ht = 6.1            # Reference height [m]
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false     # Flat domain
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3

# Heat flux parameters (Phase 5)
erf.fire.tau_residence_s = 0.0        # 0 = derive from fuel SAV and rho_p
erf.fire.f_c_min = 0.2
erf.fire.f_c_max = 0.9

# FARSITE parameters (Phase 3)
erf.fire.farsite.phi_threshold = 0.1
erf.fire.farsite.use_anderson_lw = 1
erf.fire.farsite.gaussian_sigma = -1.0     # Single-cell stamping
erf.fire.farsite.cfl_fire = 0.5

# Fire statistics output
erf.fire.write_fire_stats_csv = true
erf.fire.fire_stats_csv_file = "fire_stats_phase6.csv"

# Phase 6: fire-atmosphere coupling parameters
erf.fire.coupling_type = "lagged"
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
