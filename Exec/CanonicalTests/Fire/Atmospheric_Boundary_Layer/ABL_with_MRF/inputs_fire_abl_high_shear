# ============================================================================
# ABL-Enhanced Fire Configuration: HIGH_SHEAR
# ============================================================================
# Combines atmospheric boundary layer physics with fire dynamics
#
# Atmospheric Scenario: High wind shear - promotes rapid fire spread and intensity
# Stability: Sheared
# Reference Wind Speed: 35.0 m/s
# ============================================================================

erf.prob_name = "ABL"
max_step = 20
amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 8000  8000  2048
amr.n_cell           =  8   8   64
geometry.is_periodic = 1 1 0
zlo.type = "surface_layer"
erf.most.z0   = 0.1
erf.most.zref = 48.0
erf.most.surf_temp_flux = 0.0
zhi.type = "SlipWall"
erf.fixed_dt = 0.01  # very short timestep for extremely high velocities
erf.sum_interval   = 1
erf.v              = 1
amr.v              = 1
amr.max_level       = 0
erf.check_file      = chk_high_shear
erf.check_int       = 100
erf.data_log    = unstable_hist.dat unstable_profiles.dat
erf.profile_int = 10
erf.plot_file_1     = plt_unstable      # prefix of plotfile name
erf.plot_int_1      = 15                # number of timesteps between plotfiles
erf.plot_vars_1     = density rhoadv_0 rhoadv_1 x_velocity y_velocity z_velocity pressure temp theta
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type        = "None"
erf.theta_ref = 300.0
erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding_MRF_high_shear"
erf.input_sounding_file = "input_sounding_MRF_high_shear"
erf.use_coriolis = true
# ============================================================================
# FIRE MODULE CONFIGURATION
# ============================================================================

erf.fire.enable = true
erf.fire.fire_debug = false

# Fire grid refinement (5x finer in horizontal)
erf.fire.grid_ratio = 5

# Fuel model: 4 (Chaparral - suitable for diverse fire scenarios)
erf.fire.fuel_model_id = 4

# Fuel moisture content (NFMD standard)
erf.fire.moisture_1hr = 0.12
erf.fire.moisture_10hr = 0.12
erf.fire.moisture_100hr = 0.15
erf.fire.moisture_live = 0.90

# Wind and fire propagation
erf.fire.wind_ref_ht = 10.0
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false

# Fire atmosphere coupling
erf.fire.coupling_type = "lagged"
erf.fire.heat_flux_alfg = 45.0
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true

# Diagnostics
erf.fire.write_fire_stats_csv = true
erf.fire.fire_stats_csv_file = "fire_stats_abl_high_shear.csv"

# Plot files
erf.fire_plot_file = plt_fire_abl_high_shear_
erf.fire_plot_int = 100

# Geostrophic wind (from sounding file)
erf.abl_geo_wind = 35.0 0.0 0.0
