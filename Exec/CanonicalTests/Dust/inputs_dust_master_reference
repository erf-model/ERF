# ============================================================================
# ERF Dust Module: Master Inputs Configuration Reference
# ============================================================================
# This file documents all available dust model parameters with default values,
# allowed options, and descriptions. Use this as a reference when configuring
# dust simulations. Uncomment and modify parameters as needed.
# ============================================================================

# CORE GEOMETRY AND ATMOSPHERIC SETUP
# ============================================================================

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

# Surface layer (MOST) parameters
erf.most.z0 = 0.1

# Molecular diffusion and LES
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"

# Initial atmospheric conditions
erf.init_type = "uniform"
erf.theta_ref = 300.0

# Time stepping
erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

# Output control
erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int = 100
erf.plot_vars = theta u v

# ============================================================================

# ============================================================================
# DUST MODULE: MASTER CONTROL FLAGS
# ============================================================================

# Enable/disable dust simulation
erf.dust.enable = false

# Dust-atmospheric coupling mode
# Options: "none" (passive tracer), "lagged" (update winds), "synchronous" (feedback to momentum)
erf.dust.coupling_mode = "none"

# Dust return (feedback to atmosphere)
erf.dust.return_coupling = false

# ============================================================================
# DUST EMISSION PARAMETERS
# ============================================================================

# Threshold friction velocity model
# Options: "Bagnold" (Bagnold 1941), "Iversen" (Iversen-White 1982)
erf.dust.ustar_t_model = "Bagnold"

# Emission flux scheme
# Options: "Shao" (Shao 2004), "Marticorena" (MB95), "threshold" (step function)
erf.dust.emission_scheme = "Shao"

# Soil texture/type file (ASC format with soil codes mapped to properties)
erf.dust.soil_texture_file = ""

# Surface roughness length [m]
erf.dust.z0_dust = 0.001

# ============================================================================
# DUST PARTICLE SIZE DISTRIBUTION
# ============================================================================

# Number of dust particle size bins
erf.dust.n_dust_bins = 3

# Dust bin diameters [microns] — provide n_dust_bins values
erf.dust.dust_diameters = 1.0 10.0 100.0

# Dust bin mass fractions [dimensionless] — must sum to 1.0
erf.dust.dust_mass_fractions = 0.33 0.34 0.33

# ============================================================================
# DUST SETTLING / DEPOSITION
# ============================================================================

# Enable Stokes settling velocity calculation
erf.dust.stokes_settling = true

# Dry deposition scheme
# Options: "gravity" (gravitational settling), "surface_layer" (MOST), "none"
erf.dust.dry_deposition = "gravity"

# ============================================================================
# DUST TRANSPORT
# ============================================================================

# Advection scheme
# Options: "PPM" (Piecewise Parabolic), "Godunov", "PlainPPM"
erf.dust.advection_type = "PPM"

# Turbulent diffusion / MRF scheme
# Options: "None", "MRF" (Multifractal Reynold Stress), "Smagorinsky"
erf.dust.turb_scheme = "MRF"

# ============================================================================
# DUST-ATMOSPHERE COUPLING
# ============================================================================

# Coupling mode
# Options: "passive" (no feedback), "lagged" (update wind), "synchronous" (two-way)
erf.dust.coupling = "passive"

# Feedback to atmospheric momentum (dust loading effect)
erf.dust.momentum_feedback = false

# Return (re-entrainment) flag
erf.dust.return = false

# ============================================================================
# PHREEQC GEOCHEMISTRY COUPLING (OPTIONAL)
# ============================================================================

# Enable PHREEQC geochemistry
erf.dust.phreeqc_coupling = false

# PHREEQC input file (CSV format with reaction definitions)
erf.dust.phreeqc_file = ""

# Feedback type: "none", "pH", "speciation"
erf.dust.phreeqc_feedback = "none"

# ============================================================================
# BLAST / ROAD EMISSION SOURCES
# ============================================================================

# Blast schedule CSV file (time, source_x, source_y, source_z, mass_rate_kg_s)
erf.dust.blast_schedule_file = ""

# Road schedule CSV file (road_segment_id, activity_flag)
erf.dust.road_schedule_file = ""

# Blast source geometry
erf.dust.blast_center_x = 1000.0  # [m]
erf.dust.blast_center_y = 1000.0  # [m]
erf.dust.blast_radius = 50.0      # [m]
erf.dust.blast_height = 10.0      # [m]

# ============================================================================
# DUST SUPPRESSION
# ============================================================================

# Suppression method
# Options: "none", "water_spray", "dust_suppressant_film"
erf.dust.suppression_method = "none"

# Suppression efficiency [0.0-1.0] — fraction of emission suppressed
erf.dust.suppression_efficiency = 0.0

# ============================================================================
# OUTPUT AND DIAGNOSTICS
# ============================================================================

# Statistics CSV file for dust diagnostics
erf.dust.stats_file = ""

# Plot variables (comma-separated list of dust fields to output)
erf.dust.plot_vars = "dust_concentration dust_emission_flux"

# NAAQS diagnostic flags
erf.dust.naaqs_24hr_threshold = 35.0   # [µg/m³]
erf.dust.naaqs_annual_threshold = 12.0 # [µg/m³]
erf.dust.naaqs_diagnostic_enable = false

# MSHA/OSHA occupational dust limit
erf.dust.msha_limit = 5.0  # [mg/m³]
erf.dust.stel_threshold = 10.0  # [mg/m³]
erf.dust.stel_window = 15  # [minutes]
erf.dust.occupational_diagnostic_enable = false

# ============================================================================
# MULTI-SITE CONFIGURATION (DISTRIBUTED SOURCES)
# ============================================================================

# Number of independent dust sources (e.g., different quarries, haul roads)
erf.dust.n_sites = 1

# Site coordinates (provide n_sites x,y pairs)
erf.dust.site_0_center_x = 1000.0
erf.dust.site_0_center_y = 1000.0

# Site radius and height
erf.dust.site_0_radius = 100.0
erf.dust.site_0_height = 20.0

# ============================================================================
# DUST GRID REFINEMENT (RELATIVE TO ATMOSPHERIC GRID)
# ============================================================================

# Dust grid refinement factor (dust cells finer than atmosphere by this factor)
erf.dust.grid_ratio = 2

# ============================================================================
