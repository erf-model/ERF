erf.latitude         = 45.0
erf.abl_driver_type  = "GeostrophicWind"
erf.abl_geo_wind     = 15.0 0.0 0.0

# Required for dust scalar to be advected and diffused (PR #145).
erf.transport_scalar = true

# dust_mrf_Sc_t = 0: use same diffusivity as heat (Sc_t = Pr_t).
# Set to 2.0 to halve Scalar_v relative to Theta_v.
erf.dust.mrf_Sc_t = 0.0

