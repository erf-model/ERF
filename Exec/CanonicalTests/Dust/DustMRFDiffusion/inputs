# DustMRFDiffusion regression test
#
# Tests Phase 14: MRF nonlocal countergradient diffusion applied to dust scalar.
#
# The MRF scheme (Hong & Pan 1996) sets EddyDiff::Scalar_v = K_h for the
# passive scalar. The dust scalar (m_dust_scalar_comp) is then diffused
# vertically by DiffusionSrcForState_N using this diffusivity.
# No countergradient term is applied to dust (gamma_dust = 0).
#
# Atmospheric configuration: Moeng-Sullivan neutral ABL.
# Reference: Exec/CanonicalTests/ABL/MRF_Enhancements/canonical/neutral_abl
# MRF u* ~ 0.56 m/s with 15 m/s geostrophic wind.
#
# MRF K_h profile (Hong & Pan 1996):
#   K_h(z) = w_s * h * (z/h) * (1 - z/h)^2
#   w_s = mixed-layer velocity scale [m/s]
#   h   = PBL height [m]
# For neutral ABL with u* ~ 0.56 m/s and h ~ 500 m (MRF estimate):
#   w_s ~ u* ~ 0.56 m/s
#   K_h_peak ~ 0.56 * 500 * (1/3) * (2/3)^2 ~ 27.7 m^2/s (at z/h = 1/3)
# EddyDiff::Scalar_v_max should be of order 10-30 m^2/s.
#
# With dust_mrf_Sc_t = 0 (default): Scalar_v = Theta_v (same as heat).
# [DUST DEBUG] Phase 14 should show Scalar_v_max ~ Theta_v_max.
#
# Expected results:
#   (1) [DUST DEBUG] Phase 14 printed each step showing Scalar_v_max > 0.
#   (2) EddyDiff::Scalar_v_max ~ EddyDiff::Theta_v_max (within 1% when
#       dust_mrf_Sc_t = 0 / same as Pr_t).
#   (3) gamma_dust = 0 confirmed in debug output.
#   (4) After several steps, dust concentration profile has a nonzero
#       vertical gradient reduced by diffusion (mixing away from k=0).
#   (5) Setting dust_mrf_Sc_t = 2.0 halves Scalar_v relative to Theta_v
#       and [DUST DEBUG] shows Scalar_v_max ~ 0.5 * Theta_v_max.
#   (6) [DUST DEBUG] Phase 10, 11, 12, 13, 14 all printed each step.
#   (7) Run exits with code 0.
#
# References:
#   Hong, S.-Y., & Pan, H.-L. (1996). Mon. Wea. Rev., 124, 2322.
#     https://doi.org/10.1175/1520-0493(1996)124<2322:NBLVDI>2.0.CO;2
#   Seinfeld, J.H., & Pandis, S.N. (2006). Atmospheric Chemistry and Physics,
#     2nd ed., Ch. 16. Wiley. ISBN 978-0-471-72018-8.
#   Ginoux, P. et al. (2001). J. Geophys. Res., 106, 20255.
#     https://doi.org/10.1029/2000JD901323

erf.prob_name = "ABL"
max_step = 5
amr.max_level = 0
amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024

geometry.prob_extent = 3000 3000 1024
amr.n_cell           =  8    8   64
geometry.is_periodic = 1 1 0
amrex.max_grid_size_z = 128

zlo.type = "surface_layer"
erf.most.z0              = 0.1
erf.most.zref            = 24.0
erf.most.surf_temp_flux  = 0.0
zhi.type = "SlipWall"
zhi.theta_grad = 0.003

erf.fixed_dt     = 0.5
erf.sum_interval = 1
erf.v            = 1
amr.v            = 1
erf.check_int    = -1
erf.plot_int_1   = -1
erf.plot_vars_1  = density x_velocity y_velocity z_velocity theta

erf.use_gravity     = true
erf.molec_diff_type = "None"
erf.les_type        = "None"

erf.init_type           = "input_sounding"
erf.sounding_type       = Ideal
erf.input_sounding_file = "sounding_neutral_abl"

erf.pbl_type         = "MRF"
erf.pbl_mrf_Ribcr    = 0.5
erf.pbl_mrf_const_b  = 7.8
erf.pbl_mrf_sf       = 0.1
erf.enable_mrf_countergradient = true
