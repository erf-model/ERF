# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Neutral flow over a periodic axisymmetric hill (radial Witch of Agnesi,
# hmax = 100 m, L = 500 m at half height) on a terrain-fitted mesh with
# the one-equation k RANS closure under a MOST surface layer. Three
# dimensional counterpart of Neutral_Hill_2D: the wall distance is checked
# against the exact distance to the surface of revolution and the crest
# speed-up against the axisymmetric estimate of about 1.6 h/L.
erf.prob_name = "ABL"

erf.anelastic = 1
erf.use_fft   = true

stop_time = 14400.0   # 4 h physics run (9600 steps); CTest overrides max_step

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
# Unit aspect ratio: the Poisson wall-distance solve (the _Poisson CTest
# variant) diverges at dx = 2 dz; the terrain_height default has no such
# limit. (The projection failure once seen at dz != dx on this deck was a
# BoxArray split in z, fixed in erf-model/ERF#3970, not the aspect ratio.)
geometry.prob_lo     = -2560. -2560.   0.
geometry.prob_hi     =  2560.  2560. 800.
amr.n_cell           =    64     64   20     # dx = dy = dz = 40 m
amr.max_grid_size    = 32
amr.blocking_factor  = 4

geometry.is_periodic = 1 1 0

# TERRAIN: axisymmetric Witch of Agnesi hill centred in the domain
erf.terrain_type         = StaticFittedMesh
erf.terrain_smoothing    = 0        # basic terrain following
erf.wall_dist_type       = terrain_height   # height above the surface on its normal; "poisson" is the Tucker (2003) solve
prob.custom_terrain_type = "WoA"
prob.dir                 = 2        # radial
prob.hmax                = 100.0    # ridge height [m]
prob.L                   = 500.0    # half-width at half height [m]

# MOST BOUNDARY (adiabatic: neutral surface)
zlo.type      = "surface_layer"
erf.most.z0   = 0.1

zhi.type       = "SlipWall"
zhi.theta_grad = 0.03

# INITIALIZATION
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type       = "Ideal"

# TIME STEP CONTROL: dx = 40 m and 10 m/s give a Courant number of 0.375
erf.fixed_dt = 1.5

# DIAGNOSTICS & VERBOSITY
erf.sum_interval = 10
erf.v            = 1
amr.v            = 0

# REFINEMENT / REGRIDDING
amr.max_level = 0

# CHECKPOINT FILES
erf.check_file = chk
erf.check_int  = 9600

# PLOTFILES
erf.plot_file_1 = plt
erf.plot_int_1  = 9600
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta KE Kmv Khv Lturb walldist diss z_phys

# SOLVER CHOICE
erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

erf.use_gravity  = true
erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 90.0
erf.rotational_time_period = 125663.7061435917   # f = 1e-4 1/s

erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 10.0 0.0 0.0

# gravity-wave damping in the top 300 m
erf.rayleigh_damp_W   = true
erf.rayleigh_dampcoef = 0.2
erf.rayleigh_zdamp    = 250.

erf.molec_diff_type = "None"

# TURBULENCE MODELING: one-equation k RANS
erf.les_type            = "None"
erf.rans_type           = "kEqn"
erf.dirichlet_k         = true
erf.init_tke_from_ustar = true
erf.theta_ref           = 300.0

# PROBLEM PARAMETERS: no perturbations
prob.pert_deltaU  = 0.0
prob.pert_deltaV  = 0.0
prob.T_0_Pert_Mag = 0.0
prob.U_0_Pert_Mag = 0.0
prob.V_0_Pert_Mag = 0.0
prob.W_0_Pert_Mag = 0.0
