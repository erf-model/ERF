! Noah-MP driver options for TwoStream_NoahMP_vs_ForceRestore: those of
! Exec/RegTests/NoahMP_Ideal/namelist.erf, with a land setup file for each level
! (make_land_files.py), a 60 s land step, so that the land model follows the six-hour day as
! closely as the force-restore balance does (that one steps with ERF), and Jarvis stomata
! (CANOPY_STOMATAL_RESISTANCE_OPTION = 2), the canopy resistance the balance uses; Noah-MP's
! default Ball-Berry (1) transpires much less here (README.md).
&NOAHLSM_OFFLINE

 ERF_SETUP_FILE_01 = "wrfinput_d01"
 ERF_SETUP_FILE_02 = "wrfinput_d02"


 KDAY = 2
 SPINUP_LOOPS = 0

 DYNAMIC_VEG_OPTION                = 4
 CANOPY_STOMATAL_RESISTANCE_OPTION = 2
 BTR_OPTION                        = 1
 SURFACE_RUNOFF_OPTION             = 3
 SUBSURFACE_RUNOFF_OPTION          = 3
 DVIC_INFILTRATION_OPTION          = 1
 SURFACE_DRAG_OPTION               = 1
 FROZEN_SOIL_OPTION                = 1
 SUPERCOOLED_WATER_OPTION          = 1
 RADIATIVE_TRANSFER_OPTION         = 3
 SNOW_ALBEDO_OPTION                = 1
 PCP_PARTITION_OPTION              = 1
 SNOW_THERMAL_CONDUCTIVITY         = 1
 TBOT_OPTION                       = 2
 TEMP_TIME_SCHEME_OPTION           = 1
 GLACIER_OPTION                    = 1
 SURFACE_RESISTANCE_OPTION         = 1
 SOIL_DATA_OPTION                  = 1
 PEDOTRANSFER_OPTION               = 1
 CROP_OPTION                       = 0
 IRRIGATION_OPTION                 = 0
 IRRIGATION_METHOD                 = 0
 TILE_DRAINAGE_OPTION              = 0

 FORCING_TIMESTEP = 60
 NOAH_TIMESTEP    = 60
 OUTPUT_TIMESTEP  = 3600

 SPLIT_OUTPUT_COUNT = 24
 SKIP_FIRST_OUTPUT = .false.
 RESTART_FREQUENCY_HOURS = 24

 NSNOW = 4
 NSOIL = 4

 soil_thick_input(1) = 0.10
 soil_thick_input(2) = 0.30
 soil_thick_input(3) = 0.60
 soil_thick_input(4) = 1.00

 SF_URBAN_PHYSICS = 0
 USE_WUDAPT_LCZ = 0

/
