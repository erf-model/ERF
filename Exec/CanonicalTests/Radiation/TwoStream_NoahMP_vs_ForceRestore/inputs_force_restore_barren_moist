# Case 2 on moist bare land (run_comparison.sh --barren-moist): the barren deck with the soil at
# 0.25 m3/m3, where Noah-MP's bare-soil resistance (Sakaguchi-Zeng), r_a / (r_a + r_soil),
# sets the evaporation of both models.
FILE = inputs_force_restore_barren

# Noah-MP's bare-soil albedo falls by 0.40 x the top layer's water content (GroundAlbedoMod),
# down to the saturated value; its emissivity stays 0.97.
erf.radiation.surface_albedo_sw = 0.145

erf.radiation.seb_q_sfc_default = 0.25
erf.radiation.seb_q_deep_default = 0.25
