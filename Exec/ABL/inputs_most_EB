# ------------------  INPUTS TO MAIN PROGRAM  -------------------
erf.prob_name = "ABL with EB"

max_step = 10

amrex.fpe_trap_invalid = 1

fabarray.mfiter_tile_size = 1024 1024 1024

eb2.geometry = "plane"
eb2.plane_point = 0.0 0.0 102.5
eb2.plane_normal = 0.0 0.0 -1.0
eb2.small_volfrac = 1.e-4

# PROBLEM SIZE & GEOMETRY
geometry.prob_extent = 2400.   2400.   2000.
# amr.n_cell           =   160      160     400
amr.n_cell           =   40      40     100
geometry.is_periodic = 1 1 0

# MOST BOUNDARY (DEFAULT IS ADIABATIC FOR THETA)
# zlo.type = "surface_layer"
# erf.most.z0   = 0.1
# erf.most.zref = 8.0
zlo.type = "SlipWall"
zhi.type = "SlipWall"

# TIME STEP CONTROL
erf.fixed_dt = 0.1  # fixed time step depending on grid resolution

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk        # root name of checkpoint file
erf.check_int       = 100        # number of timesteps between checkpoints

# PLOTFILES
erf.plot_file_1     = plt       # prefix of plotfile name
erf.plot_int_1      = 10        # number of timesteps between plotfiles
erf.plot_vars_1     = density rhoadv_0 x_velocity y_velocity z_velocity pressure temp theta

# SOLVER CHOICE
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type        = "Smagorinsky"
erf.Cs              = 0.17

erf.init_type = "input_sounding"
erf.sounding_type = "Ideal"
erf.input_sounding_file = "input_sounding_EB"

# TERRRAIN GRID TYPE
erf.terrain_type = "EB"
erf.write_eb_surface = TRUE
erf.eb_boundary_type = "SlipWall"

# PROBLEM PARAMETERS
prob.rho_0 = 0.0
prob.T_0 = 0.0
prob.A_0 = 0.0
prob.U_0 = 0.0
prob.V_0 = 0.0
prob.W_0 = 0.0

prob.pert_ref_height = 602.5
prob.U_0_Pert_Mag = 0.65
prob.V_0_Pert_Mag = 0.65
prob.W_0_Pert_Mag = 0.0
prob.pert_periods_U = 12
prob.pert_periods_V = 12
prob.pert_deltaU = 1.0
prob.pert_deltaV = 1.0
