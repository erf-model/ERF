# A uniform scalar and a uniform theta in a three-dimensional flow on a flat mesh (ConstantDz;
# StretchedDz with erf.initial_dz and erf.grid_stretching_ratio).  With map factors that vary in
# space (erf.test_mapfactor_amp) and a refined level, the fluxes through the coarse/fine faces
# must add up to the coarse ones with the map factors included, or the fine projection leaves a
# divergence and advection does not keep the scalar and theta uniform.
erf.prob_name = "Scalar Advection/Diffusion"
erf.compressibility_type = Anelastic

max_step  = 30
stop_time = 1.0e6
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

geometry.prob_lo     = -1280. -1280.    0.
geometry.prob_hi     =  1280.  1280.  791.6
amr.n_cell           =    32     32   12     # dx = dy = 80 m
geometry.is_periodic = 1 1 0
amr.max_level        = 0

# Multigrid needs no FFT build, so this case runs in every CI job
erf.use_fft = false

zlo.type = "SlipWall"
zhi.type = "SlipWall"

erf.fixed_dt = 2.0        # advective CFL about 0.4
erf.v = 1
amr.v = 0
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 30
erf.plot_vars_1 = density scalar theta x_velocity y_velocity z_velocity

erf.dycore_horiz_adv_type    = "Upwind_3rd"
erf.dycore_vert_adv_type     = "Upwind_3rd"
erf.dryscal_horiz_adv_type   = "Upwind_3rd"
erf.dryscal_vert_adv_type    = "Upwind_3rd"

erf.use_gravity     = false
erf.les_type        = "None"
erf.molec_diff_type = "None"

erf.init_type = "uniform"
prob.rho_0 = 1.0
prob.T_0   = 300.0
prob.A_0   = 1.0
prob.U_0   = 10.0
prob.V_0   = 3.0
prob.rad_0 = 100.0        # a ball far larger than the domain: scalar = A_0 everywhere
prob.test_flow_amp = 2.0  # a roll in x-z and horizontal shears, so that |w| reaches 2 m/s
