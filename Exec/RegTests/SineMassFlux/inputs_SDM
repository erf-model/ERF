# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Super-droplet column rebuilt from Figure 1 of Beydoun et al. (2026), whose deck is not
# available: the kinematic warm-rain case of Shipway and Hill (2012), set up as in PySDM
erf.prob_name = "SinusoidalMassFlux"

stop_time = 3600   #  1 hour

amrex.fpe_trap_invalid = 1

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
geometry.prob_lo     =  0.   0.    0.
geometry.prob_hi     =  400. 400. 2975.
amr.n_cell           =  4    4    50      # dx=dy=100m, dz=59.5m

geometry.is_periodic = 1 1 0

zlo.type = "Outflow"
zhi.type = "Outflow"

# TIME STEP CONTROL
erf.fixed_dt           = 5.0
erf.fixed_mri_dt_ratio = 24

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp
erf.data_log       = "surf" "mean"
erf.profile_int    = 1

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk     # root name of checkpoint file
erf.check_int       = -1      # number of timesteps between checkpoints

# PLOTFILES
erf.plot_file_1     = plt     # prefix of plotfile name
erf.plot_int_1      = 2       # number of timesteps between plotfiles
erf.plot_vars_1     = density theta temp pressure z_velocity qv qc qrain qt qsat rel_humidity rain_accum precip_accum super_droplets_moisture_number_density super_droplets_moisture_radius
particles.disable_plt = true

# SOLVER CHOICE
erf.use_gravity     = true
erf.use_coriolis    = false
erf.buoyancy_type   = 1

erf.dycore_horiz_adv_type    = Upwind_3rd
erf.dycore_vert_adv_type     = Upwind_3rd
erf.dryscal_horiz_adv_type   = Upwind_3rd
erf.dryscal_vert_adv_type    = Upwind_3rd
erf.moistscal_horiz_adv_type = WENO5
erf.moistscal_vert_adv_type  = WENO5

erf.moisture_model  = "SuperDroplets"

erf.molec_diff_type = "None"
erf.les_type        = "Smagorinsky"
erf.Cs              = 0.17
erf.Pr_t      = 0.33333333333333
erf.Sc_t      = 0.33333333333333

# INITIAL STATE, KINEMATIC FORCING AND NUDGING
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding_SDM"

erf.nudging_from_input_sounding = true
erf.nudging_t                   = true    # theta held at the sounding, as in PySDM
erf.nudging_q                   = false
erf.nudging_u                   = false
erf.tau_nudging                 = 5.0
erf.add_custom_w_subsidence     = true    # rho w = 2 sin(pi t/600) kg m^-2 s^-1 for t < 600 s
erf.add_do_theta_advection      = false

# SUPER-DROPLETS
super_droplets_moisture.include_cold_processes    = false
super_droplets_moisture.include_phase_change      = true
super_droplets_moisture.num_substeps_phase_change = 10
super_droplets_moisture.include_coalescence       = true
super_droplets_moisture.coalescence_kernel        = "geometric"
super_droplets_moisture.terminal_velocity_model   = CloudRainShima
super_droplets_moisture.radius_raindrop           = 40.0e-6
super_droplets_moisture.prescribed_advection      = true
super_droplets_moisture.advect_with_flow          = true
super_droplets_moisture.advect_with_gravity       = true
super_droplets_moisture.dimensionality            = "one_d_z"
super_droplets_moisture.density_scaling           = true
super_droplets_moisture.diagnostics_interval      = 0

super_droplets_moisture.aerosols = NH42SO4
super_droplets_moisture.num_initializations = 1
super_droplets_moisture.initial_aerosol_distribution_type_NH42SO4 = "radius_lognormal_autorange"
super_droplets_moisture.initial_aerosol_mean_radius_NH42SO4       = 40.0e-9 # m
super_droplets_moisture.initial_aerosol_geomstd_radius_NH42SO4    = 1.4
super_droplets_moisture.initial_number_density = 5.0e7 #m^{-3}
super_droplets_moisture.initial_particles_per_cell = 128
