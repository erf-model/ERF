ERF_MOISTURE_WDM6_DIR = $(ERF_SOURCE_DIR)/Microphysics/WDM6
include $(ERF_MOISTURE_WDM6_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_MOISTURE_WDM6_DIR)
