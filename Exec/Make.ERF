ERF_MATPROP_DIR = $(ERF_SOURCE_DIR)/MaterialProperties
include $(ERF_MATPROP_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_MATPROP_DIR)
INCLUDE_LOCATIONS += $(ERF_MATPROP_DIR)

# If using Noah-MP model, then compile relevant source and headers
ifeq ($(USE_NOAHMP), TRUE)
  DEFINES   += -DERF_USE_NOAHMP

  ifneq ($(PRECISION),FLOAT)
    DEFINES               += -DDOUBLE_PREC
    NOAHMP_PRECISION_FLAG := -DDOUBLE_PREC
  else
    NOAHMP_PRECISION_FLAG :=
  endif

  # pkg-config wrappers for the netCDF probes. Environment is set inline on the
  # command because GNU Make < 4.4 does not pass `export`ed variables to $(shell).
  ERF_PKG_CONFIG := $(if $(MPICH_DIR),PKG_CONFIG_PATH="$(MPICH_DIR)/lib/pkgconfig:$$PKG_CONFIG_PATH") pkg-config

  # Keep system -I dirs for the Fortran probe: gfortran does not search
  # /usr/include for .mod files, so a dropped -I/usr/include loses netcdf.mod.
  ERF_PKG_CONFIG_F := PKG_CONFIG_ALLOW_SYSTEM_CFLAGS=1 $(ERF_PKG_CONFIG)

  # Try netcdf-fortran => netcdf-fortran_parallel. The Fortran include flags are
  # captured in NETCDF_FORTRAN_CFLAGS rather than appended straight to `includes`
  # so that the Noah-MP sub-make (below) can be handed the very same flags. If the
  # Noah-MP Fortran sources are compiled against a different netCDF-Fortran install
  # than the one we link against, the mangled module symbols still resolve and the
  # link succeeds -- but the procedure signatures disagree, and calls arrive with
  # their arguments (including the hidden character lengths) in the wrong slots.
  ifeq ($(shell $(ERF_PKG_CONFIG_F) --exists netcdf-fortran 2>/dev/null; echo $$?),0)
    NETCDF_FORTRAN_PKG := netcdf-fortran
  else ifeq ($(shell $(ERF_PKG_CONFIG_F) --exists netcdf-fortran_parallel 2>/dev/null; echo $$?),0)
    NETCDF_FORTRAN_PKG := netcdf-fortran_parallel
  else
    $(error NetCDF Fortran not found. Tried netcdf-fortran and netcdf-fortran_parallel; set PKG_CONFIG_PATH to the directory holding netcdf-fortran.pc)
  endif

  NETCDF_FORTRAN_CFLAGS := $(shell $(ERF_PKG_CONFIG_F) --cflags $(NETCDF_FORTRAN_PKG))
  LIBRARIES             += $(shell $(ERF_PKG_CONFIG) --libs $(NETCDF_FORTRAN_PKG))

  includes += $(NETCDF_FORTRAN_CFLAGS)

  # Hand the sub-make exactly what pkg-config told us, even when that is the empty
  # string: pkg-config omits include directories the compiler already searches, so
  # an install under /usr legitimately yields no -I flags. Passing an empty
  # NETCDF_INCFLAGS= is the correct answer there -- leaving the override off would
  # let the sub-make fall back to whichever nf-config happens to be first on PATH,
  # which is the mixed-install mismatch we are trying to prevent. We only get here
  # if one of the two pkg-config probes above succeeded.
  NOAHMP_SUBMAKE_NETCDF := NETCDF_INCFLAGS="$(NETCDF_FORTRAN_CFLAGS)"

  NOAHMP_HOME ?= $(ERF_HOME)/Submodules/Noah-MP

  VPATH_LOCATIONS   += $(NOAHMP_HOME)/drivers/erf
  INCLUDE_LOCATIONS += $(NOAHMP_HOME)/drivers/erf
  INCLUDE_LOCATIONS += $(NOAHMP_HOME)/drivers/erf/include

  ERF_LSM_NOAHMP_DIR = $(ERF_SOURCE_DIR)/LandSurfaceModel/Noah-MP
  include $(ERF_LSM_NOAHMP_DIR)/Make.package
  VPATH_LOCATIONS   += $(ERF_LSM_NOAHMP_DIR)
  INCLUDE_LOCATIONS += $(ERF_LSM_NOAHMP_DIR)

  LIBRARY_LOCATIONS += $(NOAHMP_HOME)/drivers/erf/lib
  LIBRARIES += -lnoahmp -lgfortran -lquadmath -lnetcdff
endif

ERF_RAD_DIR = $(ERF_SOURCE_DIR)/Radiation
include $(ERF_RAD_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_RAD_DIR)
INCLUDE_LOCATIONS += $(ERF_RAD_DIR)

