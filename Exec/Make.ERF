include $(ERF_RAD_SIMPLE_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_RAD_SIMPLE_DIR)
INCLUDE_LOCATIONS += $(ERF_RAD_SIMPLE_DIR)

ERF_RADIATION_DIR = $(ERF_SOURCE_DIR)/Radiation/TwoStream
include $(ERF_RADIATION_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_RADIATION_DIR)
INCLUDE_LOCATIONS += $(ERF_RADIATION_DIR)

# If using RRTMGP Radiation, compile relevant source and headers
ifeq ($(USE_RRTMGP), TRUE)

  DEFINES += -DERF_USE_RRTMGP
  DEFINES += -DRRTMGP_ENABLE_KOKKOS

  RRTMGP_HOME       ?= $(ERF_HOME)/Submodules/RRTMGP

  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/rrtmgp
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/rrtmgp/kernels
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/rte
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/rte/kernels
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/examples
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/examples/all-sky
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/extensions/fluxes_byband
  VPATH_LOCATIONS   += $(RRTMGP_HOME)/cpp/extensions/cloud_optics

  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/rrtmgp
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/rrtmgp/kernels
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/rte
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/rte/kernels
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/examples
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/examples/all-sky
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/extensions/fluxes_byband
  INCLUDE_LOCATIONS += $(RRTMGP_HOME)/cpp/extensions/cloud_optics
endif

DEFINES += -DERF_HAS_SHOC_FAMILY

# If using EAMxx SHOC, compile relevant source and headers
ifeq ($(USE_EAMXX_SHOC), TRUE)

    DEFINES += -DERF_USE_KOKKOS
    DEFINES += -DERF_USE_EAMXX_SHOC
    DEFINES += -DSHOC_ENABLE_KOKKOS
    DEFINES += -DEKAT_ENABLE_MPI
    DEFINES += -DSCREAM_SHOC_SMALL_KERNELS

    # Location of EKAT include and library
    INCLUDE_LOCATIONS += $(EKAT_HOME)/include
    INCLUDE_LOCATIONS += $(EKAT_HOME)/include/ekat
    INCLUDE_LOCATIONS += $(ERF_HOME)/Submodules/ekat/src/kokkos
    INCLUDE_LOCATIONS += $(ERF_HOME)/Submodules/ekat/src/pack
    INCLUDE_LOCATIONS += $(ERF_HOME)/Submodules/ekat/src/algorithm
    LIBRARY_LOCATIONS += $(EKAT_LIB_DIR)
    LIBRARIES += -lekat_core -lspdlog

    # This directory holds the ERF-SHOC interface routines
    ERF_SHOC_DIR = $(ERF_SOURCE_DIR)/PhysicsInterfaces/Shoc
    include $(ERF_SHOC_DIR)/Make.package
    VPATH_LOCATIONS   += $(ERF_SHOC_DIR)
    INCLUDE_LOCATIONS += $(ERF_SHOC_DIR)

    # This directory holds the SHOC source itself
    SHOC_HOME = $(EAMXX_HOME)/physics/shoc
    VPATH_LOCATIONS   += $(SHOC_HOME)/disp
    VPATH_LOCATIONS   += $(SHOC_HOME)/eti
    INCLUDE_LOCATIONS += $(SHOC_HOME)
    INCLUDE_LOCATIONS += $(SHOC_HOME)/eti
    INCLUDE_LOCATIONS += $(SHOC_HOME)/impl

    # Other things we get from eamxx
    VPATH_LOCATIONS   += $(EAMXX_HOME)/physics/share
    INCLUDE_LOCATIONS += $(EAMXX_HOME)
    INCLUDE_LOCATIONS += $(EAMXX_HOME)/physics
    INCLUDE_LOCATIONS += $(EAMXX_HOME)/physics/share
endif

# ---- LAPACK support ----
USE_LAPACK ?= FALSE

ifeq ($(USE_LAPACK), TRUE)
  DEFINES += -DUSE_LAPACK
  # Try pkg-config first (works on many systems)
  has_lapack := $(shell pkg-config --exists lapack 2>/dev/null; echo $$?)
  ifeq ($(has_lapack),0)
    includes  += $(shell pkg-config --cflags lapack)
    LIBRARIES += $(shell pkg-config --libs lapack)
  else
    # Fallback guesses
    # Linux (generic)
    LIBRARIES += -llapack -lblas
  endif

endif
# ------------------------


include $(AMREX_HOME)/Src/Base/Make.package

AMReXdirs             := Base Boundary AmrCore

ifeq ($(USE_PARTICLES),TRUE)
AMReXdirs             += Particle
endif

ifeq ($(USE_EB),TRUE)
AMReXdirs             += EB
endif

USE_LINEAR_SOLVERS_INCFLO = TRUE
USE_LINEAR_SOLVERS_EM     = FALSE
AMReXdirs                += LinearSolvers

ifeq ($(USE_FFT),TRUE)
AMReXdirs                += FFT
endif

AMReXpack             += $(foreach dir, $(AMReXdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)

include $(AMReXpack)

ifeq ($(COMPUTE_ERROR), TRUE)
  DEFINES += -DERF_COMPUTE_ERROR
endif

ifeq ($(USE_PARTICLES), TRUE)
  DEFINES += -DERF_USE_PARTICLES
endif

ifeq ($(USE_MULTIBLOCK), TRUE)
  DEFINES += -DERF_USE_MULTIBLOCK
endif

# NOTE: EKAT provides KOKKOS
ifeq ($(USE_KOKKOS), TRUE)
  # Assumes Kokkos comes from the EKAT install selected above. Some platforms
  # do not need or provide libdl; set KOKKOS_EXTRA_LIBS= in that case.
  KOKKOS_EXTRA_LIBS ?= -ldl
  DEFINES   += -DERF_USE_KOKKOS
  INCLUDE_LOCATIONS += $(EKAT_HOME)/include/kokkos
  LIBRARY_LOCATIONS += $(EKAT_LIB_DIR)
  LIBRARIES += -lkokkoscore $(KOKKOS_EXTRA_LIBS)
endif

ifeq ($(USE_KOKKOS), TRUE)
# When using CUDA, employ the KOKKOS nvcc wrapper (nvcc isn't GCC-compatible)
EKAT_CXX := $(CXX)
ifeq ($(USE_CUDA), TRUE)
    EKAT_CXX := $(EKAT_SOURCE_DIR)/extern/kokkos/bin/nvcc_wrapper
endif

# These defaults build the subset of EKAT/Kokkos needed by ERF. Backend choices
# mirror the AMReX-style USE_OMP/USE_CUDA/USE_HIP/USE_SYCL switches from the
# including GNUmakefile. Use EKAT_EXTRA_CMAKE_FLAGS for compiler, architecture,
# or site-specific CMake options that are not represented here.
EKAT_CMAKE_FLAGS := \
  -D CMAKE_BUILD_TYPE:STRING=Release \
  -D CMAKE_CXX_COMPILER:STRING="$(EKAT_CXX)" \
  -D CMAKE_CXX_STANDARD:STRING=17 \
  -D CMAKE_INSTALL_PREFIX:PATH="$(EKAT_INSTALL_PREFIX)" \
  -D CMAKE_INSTALL_LIBDIR:PATH="$(EKAT_INSTALL_LIBDIR)" \
  -D CMAKE_DISABLE_FIND_PACKAGE_spdlog:BOOL=TRUE \
  -D EKAT_ENABLE_MPI:BOOL=ON \
  -D EKAT_ENABLE_FORTRAN:BOOL=OFF \
  -D EKAT_ENABLE_TESTS:BOOL=OFF \
  -D EKAT_ENABLE_KOKKOS:BOOL=ON \
  -D EKAT_ENABLE_LOGGING:BOOL=ON \
  -D Kokkos_ENABLE_DEPRECATED_CODE:BOOL=OFF \
  -D Kokkos_ENABLE_EXPLICIT_INSTANTIATION:BOOL=OFF \
  -D Kokkos_ENABLE_SERIAL:BOOL=ON

# Every backend is passed explicitly, including the OFF cases. CMake cache
# variables persist across configures, so a backend that is only ever passed as
# ON can never be turned back off by reconfiguring an existing build directory.
EKAT_CMAKE_FLAGS += \
  -D Kokkos_ENABLE_OPENMP:BOOL=$(call erf_bool_onoff,$(USE_OMP)) \
  -D Kokkos_ENABLE_CUDA:BOOL=$(call erf_bool_onoff,$(USE_CUDA)) \
  -D Kokkos_ENABLE_HIP:BOOL=$(call erf_bool_onoff,$(USE_HIP)) \
  -D Kokkos_ENABLE_SYCL:BOOL=$(call erf_bool_onoff,$(USE_SYCL))

# Backend sub-options are only meaningful when their backend is on, and some
# Kokkos versions reject or deprecate them otherwise, so these stay gated.
ifeq ($(USE_CUDA), TRUE)
  EKAT_CMAKE_FLAGS += \
    -D Kokkos_ENABLE_CUDA_LAMBDA:BOOL=ON \
    -D Kokkos_ENABLE_CUDA_RELOCATABLE_DEVICE_CODE:BOOL=ON
endif
ifeq ($(USE_HIP), TRUE)
  EKAT_CMAKE_FLAGS += \
    -D Kokkos_ENABLE_HIP_LAMBDA:BOOL=ON \
    -D Kokkos_ENABLE_HIP_RELOCATABLE_DEVICE_CODE:BOOL=ON
endif
ifeq ($(USE_SYCL), TRUE)
  EKAT_CMAKE_FLAGS += \
    -D Kokkos_ENABLE_SYCL_LAMBDA:BOOL=ON
endif
EKAT_CMAKE_FLAGS += $(EKAT_EXTRA_CMAKE_FLAGS)

# The backend state build_ekat expects to find recorded in the installed
# KokkosCore_config.h. Keying the paths by configuration keeps configurations
# apart, but it cannot detect an install that was built by other means, hand
# modified, or left behind by an older layout, so the install is verified
# against this list rather than merely tested for existence.
EKAT_KOKKOS_EXPECTED := \
  KOKKOS_ENABLE_SERIAL=ON \
  KOKKOS_ENABLE_OPENMP=$(call erf_bool_onoff,$(USE_OMP)) \
  KOKKOS_ENABLE_CUDA=$(call erf_bool_onoff,$(USE_CUDA)) \
  KOKKOS_ENABLE_HIP=$(call erf_bool_onoff,$(USE_HIP)) \
  KOKKOS_ENABLE_SYCL=$(call erf_bool_onoff,$(USE_SYCL))
endif

# Turn on NetCDF macro define
ifeq ($(USE_NETCDF), TRUE)
  DEFINES += -DERF_USE_NETCDF

  # Try netcdf-mpi => netcdf => netcdf-cxx4_parallel => netcdf_parallel
  # We need to add MPICH_DIR to pkg's config path because of a Cray bug.
  has_netcdf_mpi := $(shell pkg-config --cflags netcdf-mpi > /dev/null 2>&1; echo $$?)
  ifeq ($(has_netcdf_mpi),0)
      includes  += $(shell pkg-config --cflags netcdf-mpi)
      LIBRARIES += $(shell pkg-config --libs netcdf-mpi)

  else
    has_netcdf := $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --exists netcdf 2>/dev/null; echo $$?)
    ifeq ($(has_netcdf),0)
      includes  += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --cflags netcdf)
      LIBRARIES += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --libs netcdf)
    else
      has_netcdf_cxx4_parallel := $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --exists netcdf-cxx4_parallel 2>/dev/null; echo $$?)
      ifeq ($(has_netcdf_cxx4_parallel),0)
        includes  += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --cflags netcdf-cxx4_parallel)
        LIBRARIES += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --libs netcdf-cxx4_parallel)
      else
        has_netcdf_parallel := $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --exists netcdf_parallel 2>/dev/null; echo $$?)
        ifeq ($(has_netcdf_parallel),0)
          includes  += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --cflags netcdf_parallel)
          LIBRARIES += $(shell if [ -n "$$MPICH_DIR" ]; then export PKG_CONFIG_PATH="$$MPICH_DIR/lib/pkgconfig:$$PKG_CONFIG_PATH"; fi; pkg-config --libs netcdf_parallel)
        else
          $(warning NetCDF not found. Tried netcdf-mpi, netcdf, netcdf-cxx4_parallel, and netcdf_parallel)
        endif
      endif
    endif
  endif
endif

ifeq ($(USE_TERRAIN_VELOCITY), TRUE)
  DEFINES += -DERF_USE_TERRAIN_VELOCITY
endif

ifeq ($(USE_ML_UPHYS_DIAGNOSTICS), TRUE)
  DEFINES += -DERF_USE_ML_UPHYS_DIAGNOSTICS
endif

# The generated build info is per configuration, not per source tree: the
# recorded compiler and link flags differ between configurations, and object
# trees are already keyed by optionsSuffix. A single shared AMReX_buildInfo.cpp
# would therefore stamp whichever configuration regenerated it last onto every
# other configuration's executable. The name has to stay a bare filename in this
# directory so that the pattern rule in Make.rules can resolve it: make searches
# VPATH for the plain name, and when the file does not exist yet it falls back to
# looking for an explicit rule with exactly that target.
ERF_BUILDINFO_SRC := AMReX_buildInfo.$(optionsSuffix).cpp
ERF_BUILDINFO_OBJ := $(objEXETempDir)/$(ERF_BUILDINFO_SRC:%.cpp=%.o)

CEXE_sources += $(ERF_BUILDINFO_SRC)
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS += $(AMREX_HOME)/Tools/C_scripts

include $(AMREX_HOME)/Tools/GNUMake/Make.rules

# Prebuild targets are feature-gated. In particular, all should not build EKAT
# unless GNUmakefile selected a Kokkos-using feature, directly or indirectly.
ERF_PREBUILD_TARGETS :=

.PHONY: build_ekat build_noahmp

ifeq ($(USE_KOKKOS), TRUE)
ERF_PREBUILD_TARGETS += build_ekat

build_ekat:
ifeq ($(BUILD_EKAT), TRUE)
	@# An install is reused only when it exists and its recorded Kokkos backends
	@# match this configuration. The existence check accepts static or shared
	@# Kokkos libraries.
	@set -e; \
	kokkos_cfg="$(EKAT_INSTALL_PREFIX)/include/kokkos/KokkosCore_config.h"; \
	if [ -f "$(EKAT_INSTALL_PREFIX)/include/kokkos/Kokkos_Core.hpp" ] && ls "$(EKAT_LIB_DIR)"/libkokkoscore.* >/dev/null 2>&1; then \
	  mismatch=''; \
	  for spec in $(EKAT_KOKKOS_EXPECTED); do \
	    macro=$${spec%%=*}; want=$${spec##*=}; \
	    if grep -qx "#define $$macro" "$$kokkos_cfg" 2>/dev/null; then have=ON; else have=OFF; fi; \
	    if [ "$$want" != "$$have" ]; then mismatch="$$mismatch $$macro(want=$$want,found=$$have)"; fi; \
	  done; \
	  if [ -z "$$mismatch" ]; then exit 0; fi; \
	  echo "EKAT/Kokkos install in $(EKAT_INSTALL_PREFIX) does not match this configuration:$$mismatch"; \
	  if [ "$(ERF_EKAT_HOME_IS_DEFAULT)" != "TRUE" ]; then \
	    echo "EKAT_HOME was supplied externally, so it will not be removed."; \
	    echo "Point EKAT_HOME at a matching install, or unset it to build the bundled EKAT."; \
	    exit 1; \
	  fi; \
	  echo "Removing the stale bundled build and reconfiguring from scratch."; \
	  rm -rf "$(EKAT_BUILD_DIR)" "$(EKAT_INSTALL_PREFIX)"; \
	fi; \
	echo "Building EKAT/Kokkos in $(EKAT_BUILD_DIR)"; \
	cmake -S "$(EKAT_SOURCE_DIR)" -B "$(EKAT_BUILD_DIR)" $(EKAT_CMAKE_FLAGS); \
	cmake --build "$(EKAT_BUILD_DIR)" --target install --parallel
else
	@# EKAT_HOME was supplied externally unless BUILD_EKAT=TRUE was requested.
	@# Nothing here may rebuild or delete it, so a backend disagreement is a
	@# hard error rather than a reconfigure.
	@set -e; \
	kokkos_cfg="$(EKAT_INSTALL_PREFIX)/include/kokkos/KokkosCore_config.h"; \
	if [ ! -f "$(EKAT_INSTALL_PREFIX)/include/kokkos/Kokkos_Core.hpp" ] || ! ls "$(EKAT_LIB_DIR)"/libkokkoscore.* >/dev/null 2>&1; then \
	  echo "EKAT/Kokkos install not found under EKAT_HOME=$(EKAT_HOME)"; \
	  echo "Set BUILD_EKAT=TRUE to build the bundled EKAT install, or set EKAT_HOME to a valid install."; \
	  exit 1; \
	fi; \
	mismatch=''; \
	for spec in $(EKAT_KOKKOS_EXPECTED); do \
	  macro=$${spec%%=*}; want=$${spec##*=}; \
	  if grep -qx "#define $$macro" "$$kokkos_cfg" 2>/dev/null; then have=ON; else have=OFF; fi; \
	  if [ "$$want" != "$$have" ]; then mismatch="$$mismatch $$macro(want=$$want,found=$$have)"; fi; \
	done; \
	if [ -n "$$mismatch" ]; then \
	  echo "EKAT/Kokkos install under EKAT_HOME=$(EKAT_HOME) does not match this configuration:$$mismatch"; \
	  echo "Building against it would compile ERF and the installed Kokkos headers for different backends."; \
	  echo "Set BUILD_EKAT=TRUE to build a matching bundled install, or point EKAT_HOME at one."; \
	  exit 1; \
	fi
endif
else
build_ekat:
endif

ifeq ($(USE_NOAHMP), TRUE)
ERF_PREBUILD_TARGETS += build_noahmp

# NOTE: the Noah-MP object rules depend only on their sources and .d files, not on
# these flags, so changing NETCDF_INCFLAGS (e.g. by pointing PKG_CONFIG_PATH at a
# different netCDF-Fortran) does not by itself trigger a recompile. Run
# `make realclean`, or clean $(NOAHMP_HOME)/drivers/erf, when switching installs.
build_noahmp:
	$(MAKE) -C $(NOAHMP_HOME)/drivers/erf -f Makefile all_noahmp NOAHMP_PRECISION_FLAG="$(NOAHMP_PRECISION_FLAG)" $(NOAHMP_SUBMAKE_NETCDF)

# Build Noah-MP (codegen + libnoahmp.a) before any ERF object; -j ignores the
# all prereq order, so an order-only dependency is needed to enforce it.

$(objForExecs): | build_noahmp
else
build_noahmp:
endif

ifeq ($(USE_KOKKOS), TRUE)
$(objForExecs): | build_ekat
endif

all: $(ERF_PREBUILD_TARGETS) $(executable)
	@echo SUCCESS

# The build info compiled into the executable (git hashes, build date, compiler
# flags) is reported at startup and recorded in plotfile/checkpoint job_info, so
# it has to describe the binary that is actually being linked. Depending on every
# other object regenerates it exactly when the binary changes: a no-op build
# leaves it alone, and any recompile refreshes it before the link. Do not rely on
# deleting the file from a build target instead -- a bare `make` builds
# $(executable), not `all`, because Make.rules is included above and defines the
# default goal, so that cleanup would never run.
$(ERF_BUILDINFO_SRC): $(filter-out $(ERF_BUILDINFO_OBJ),$(objForExecs))
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --output_dir $(objEXETempDir) \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --CXX_comp_name "$(CXX)" \
          --CXX_flags "$(CXXFLAGS) $(CXXFLAGS) $(CPPFLAGS) $(includes)" \
          --link_flags "$(LINKFLAGS) $(CPPFLAGS) $(includes) $(LDFLAGS)" \
          --libraries "$(FINAL_LIBS)" \
          --MODULES "$(MNAMES)" \
          --GIT "$(ERF_HOME) $(AMREX_HOME)" \
          --GIT_STYLE "--always --dirty"
	$(SILENT) mv $(objEXETempDir)/AMReX_buildInfo.cpp $@

clean::
	$(SILENT) $(RM) $(ERF_BUILDINFO_SRC)
ifeq ($(USE_NOAHMP), TRUE)
	$(MAKE) -C $(NOAHMP_HOME)/drivers/erf -f Makefile clean_noahmp
endif
ifeq ($(USE_KOKKOS), TRUE)
	rm -rf $(EKAT_BUILD_DIR)
endif
