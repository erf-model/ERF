include $(ERF_MOISTURE_SATADJ_DIR)/Make.package
VPATH_LOCATIONS   += $(ERF_MOISTURE_SATADJ_DIR)
INCLUDE_LOCATIONS += $(ERF_MOISTURE_SATADJ_DIR)

