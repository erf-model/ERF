# Shared Fortran support modules. module_libmassv, mp_radar and
# module_model_constants exist as byte-identical copies under WSM6, WDM6 and
# Morrison, so each basename is listed exactly once here and left out of the
# per-scheme Make.package files. Listing one twice would compile the module
# twice into a single target. VPATH resolves each name against the microphysics
# directories above, so the copy that gets built is whichever comes first.
ifneq ($(filter TRUE,$(USE_WSM6_FORT) $(USE_WDM6_FORT)),)
  F90EXE_sources += ERF_module_libmassv.F90
  F90EXE_sources += ERF_mp_radar.F90
endif
ifneq ($(filter TRUE,$(USE_MORR_FORT) $(USE_WDM6_FORT)),)
  F90EXE_sources += ERF_module_model_constants.F90
endif

# Any Fortran in the build: the exit trap in main.cpp flushes the Fortran units
# before it ends the process (Source/Utils/ERF_FlushFortranUnits.F90).
ifneq ($(filter TRUE,$(USE_MORR_FORT) $(USE_WSM6_FORT) $(USE_WDM6_FORT) $(USE_NOAHMP)),)
  F90EXE_sources += ERF_FlushFortranUnits.F90
  DEFINES += -DERF_HAS_FORTRAN
endif

