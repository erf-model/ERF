AMREX_HOME ?= $(ERF_HOME)/Submodules/AMReX

ERF_ABS_HOME := $(abspath $(ERF_HOME))

# EKAT/Kokkos policy:
# - If EKAT_HOME is not supplied by the including GNUmakefile, the environment,
#   or the command line, assume ERF should use the bundled EKAT submodule and
#   build/install it under Submodules/ekat when Kokkos is needed. The bundled
#   build and install directories are keyed by the Kokkos backend selection
#   (see EKAT_CONFIG_TAG below), so configurations that disagree about a
#   backend do not share, overwrite, or silently reuse one another's install.
# - If EKAT_HOME is supplied, assume it points at a usable EKAT/Kokkos install
#   and do not rebuild it unless BUILD_EKAT=TRUE is explicitly requested.
# - EKAT_INSTALL_LIBDIR defaults to lib, but can be set to lib64 or another
#   install libdir on systems with a different CMake layout.
#
# The config-dependent paths are derived after the Make.defs include, where the
# USE_* backend switches and COMP have been normalized.
ifeq ($(origin EKAT_HOME), undefined)
  ERF_EKAT_HOME_IS_DEFAULT := TRUE
  BUILD_EKAT ?= TRUE
else
  ERF_EKAT_HOME_IS_DEFAULT := FALSE
  BUILD_EKAT ?= FALSE
endif

EKAT_SOURCE_DIR ?= $(ERF_ABS_HOME)/Submodules/ekat
EKAT_INSTALL_LIBDIR ?= lib

# Map an AMReX-style TRUE/FALSE switch onto a CMake ON/OFF value.
erf_bool_onoff = $(if $(filter TRUE,$(1)),ON,OFF)
EAMXX_HOME ?= $(ERF_HOME)/external/E3SM/components/eamxx/src

USE_EAMXX_SHOC  ?= $(USE_SHOC)

# Normalize feature dependencies before Make.defs and Make.package includes.
# GNUmakefile remains the user-facing switchboard; this block only enforces
# dependencies that are required by selected features. The overrides are
# intentional so contradictory command-line settings such as
# USE_RRTMGP=TRUE USE_KOKKOS=FALSE do not create an inconsistent build graph.
#
# Noah-MP and RRTMGP are independent, matching the CMake options: Noah-MP needs
# only NetCDF, and runs against whichever radiation model is selected, either
# RRTMGP or the two-stream scheme.
ifeq ($(USE_NOAHMP), TRUE)
  override USE_NETCDF = TRUE
endif
ifeq ($(USE_RRTMGP), TRUE)
  override USE_KOKKOS = TRUE
  override USE_NETCDF = TRUE
endif
ifeq ($(USE_EAMXX_SHOC), TRUE)
  override USE_KOKKOS = TRUE
endif

ifeq ($(USE_SHOC), TRUE)
$(warning USE_SHOC=TRUE is deprecated; use USE_EAMXX_SHOC=TRUE)
endif

# ERF builds for at most one parallel backend at a time, so selecting more than
# one is rejected instead of configured. Unlike the implied options above, this
# is a contradiction between switches the user set deliberately and there is no
# correct way to resolve it by overriding one of them. The CMake build applies
# the same rule to the matching ERF_ENABLE_* options.
ERF_BACKENDS_ENABLED := $(strip \
  $(if $(filter TRUE,$(USE_OMP)),USE_OMP) \
  $(if $(filter TRUE,$(USE_CUDA)),USE_CUDA) \
  $(if $(filter TRUE,$(USE_HIP)),USE_HIP) \
  $(if $(filter TRUE,$(USE_SYCL)),USE_SYCL))
ifeq ($(filter 0 1,$(words $(ERF_BACKENDS_ENABLED))),)
  $(error At most one of USE_OMP, USE_CUDA, USE_HIP, USE_SYCL may be TRUE; got $(ERF_BACKENDS_ENABLED))
endif

# The checked-in Source/PhysicsInterfaces/eamxx_config.h defines SCREAM_DOUBLE_PRECISION, so the
# EAMxx ETI files instantiate the SHOC templates for double only, while ERF instantiates them
# with amrex::Real.  Refuse a single-precision build here rather than failing at link time.
ifeq ($(USE_EAMXX_SHOC), TRUE)
  ifeq ($(PRECISION), FLOAT)
    $(error USE_EAMXX_SHOC=TRUE requires PRECISION=DOUBLE because the vendored eamxx_config.h builds EAMxx in double precision)
  endif
endif

# Default is no Fortran build unless an explicit Fortran bridge/model is enabled.
# Keep this TRUE when USE_MORR_FORT, USE_WSM6_FORT and USE_WDM6_FORT are unset.
BL_NO_FORT = TRUE
ifeq ($(USE_MORR_FORT), TRUE)
DEFINES += -DERF_USE_MORR_FORT
BL_NO_FORT = FALSE
endif
ifeq ($(USE_WSM6_FORT), TRUE)
DEFINES += -DERF_USE_WSM6_FORT
BL_NO_FORT = FALSE
endif
ifeq ($(USE_WDM6_FORT), TRUE)
DEFINES += -DERF_USE_WDM6_FORT
BL_NO_FORT = FALSE
endif

# Mirrors the ERF_WDM6_F32_LITERALS CMake option, which defaults ON. The WDM6
# Fortran parameters carry no kind suffix, so as compiled they hold float32
# values, and reproducing that in the native path is what keeps the two paths in
# agreement. Read the LITERAL PRECISION CONTRACT comment in
# Source/Microphysics/WDM6/ERF_WDM6.H before changing this.
USE_WDM6_F32_LITERALS ?= TRUE
ifeq ($(USE_WDM6_F32_LITERALS), TRUE)
DEFINES += -DERF_WDM6_F32_LITERALS
endif

ifeq ($(USE_CUDA), TRUE)
    DEFINES += -DERF_USE_CUDA
endif
ifeq ($(USE_HIP), TRUE)
    DEFINES += -DERF_USE_HIP
endif
ifeq ($(USE_SYCL), TRUE)
    DEFINES += -DERF_USE_SYCL
endif

USE_EB = TRUE

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

# Mirrors the CMake guard: the WDM6 Fortran bridge is double-precision only.
# PRECISION is normalized by Make.defs, so this has to come after the include.
ifeq ($(USE_WDM6_FORT), TRUE)
  ifneq ($(PRECISION), DOUBLE)
    $(error USE_WDM6_FORT requires PRECISION=DOUBLE because the WDM6 Fortran bridge is double-precision only)
  endif
endif

# Key the bundled EKAT/Kokkos build and install trees by the configuration that
# is actually baked into the installed Kokkos headers: the compiler and the set
# of enabled backends. A single fixed install under Submodules/ekat/build is
# shared by every configuration, and build_ekat below skips the CMake configure
# whenever an install is already present, so once a USE_CUDA=TRUE build has
# populated it a later USE_CUDA=FALSE build in the same source tree compiles
# against Kokkos headers that #define KOKKOS_ENABLE_CUDA using a host compiler
# that never defines __CUDACC__, which Kokkos_Setup_Cuda.hpp rejects outright.
# The CMake build avoids this by configuring EKAT inside each build directory;
# keying the paths here gives the GNU Make build the same isolation.
EKAT_CONFIG_TAG := $(if $(strip $(COMP)),$(strip $(COMP)),unknown-comp)
ifeq ($(USE_MPI), TRUE)
  EKAT_CONFIG_TAG := $(EKAT_CONFIG_TAG).MPI
endif
ifeq ($(USE_OMP), TRUE)
  EKAT_CONFIG_TAG := $(EKAT_CONFIG_TAG).OMP
endif
ifeq ($(USE_CUDA), TRUE)
  EKAT_CONFIG_TAG := $(EKAT_CONFIG_TAG).CUDA
endif
ifeq ($(USE_HIP), TRUE)
  EKAT_CONFIG_TAG := $(EKAT_CONFIG_TAG).HIP
endif
ifeq ($(USE_SYCL), TRUE)
  EKAT_CONFIG_TAG := $(EKAT_CONFIG_TAG).SYCL
endif

DEFAULT_EKAT_HOME := $(EKAT_SOURCE_DIR)/build/$(EKAT_CONFIG_TAG)/install
ifeq ($(ERF_EKAT_HOME_IS_DEFAULT), TRUE)
  EKAT_HOME := $(DEFAULT_EKAT_HOME)
endif
EKAT_BUILD_DIR ?= $(EKAT_SOURCE_DIR)/build/$(EKAT_CONFIG_TAG)
EKAT_INSTALL_PREFIX := $(abspath $(EKAT_HOME))
EKAT_LIB_DIR ?= $(EKAT_INSTALL_PREFIX)/$(EKAT_INSTALL_LIBDIR)

# Before the paths were keyed, the bundled EKAT was configured directly in
# $(EKAT_SOURCE_DIR)/build. Nothing reads that tree any more, and leaving it in
# place is how a CUDA-enabled install came to be reused by host-only builds, so
# say plainly that it is dead and can go.
ifeq ($(USE_KOKKOS), TRUE)
  ifneq ($(wildcard $(EKAT_SOURCE_DIR)/build/CMakeCache.txt),)
    $(warning Unused EKAT build from the old unkeyed layout found in $(EKAT_SOURCE_DIR)/build. It is no longer used by any configuration; remove it with: rm -rf $(EKAT_SOURCE_DIR)/build/CMakeCache.txt $(EKAT_SOURCE_DIR)/build/CMakeFiles $(EKAT_SOURCE_DIR)/build/install)
  endif
endif

EBASE = ERF
ifeq ($(USE_NETCDF), TRUE)
  USERSuffix := $(USERSuffix).NC
endif
ifeq ($(USE_PARTICLES), TRUE)
  USERSuffix := $(USERSuffix).PART
endif
ifeq ($(USE_FFT), TRUE)
  USERSuffix := $(USERSuffix).FFT
endif
ifeq ($(USE_NOAHMP), TRUE)
  USERSuffix := $(USERSuffix).NMP
endif
ifeq ($(USE_RRTMGP), TRUE)
  USERSuffix := $(USERSuffix).RRTMGP
endif

