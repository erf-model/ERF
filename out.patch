+    set(RUNTIME_OPTIONS "${ADD_TEST_D_RUNTIME_OPTIONS}")
+    if(NOT "${ADD_TEST_D_INPUT_SOUNDING}" STREQUAL "")
+      string(APPEND RUNTIME_OPTIONS "erf.input_sounding_file=${CURRENT_TEST_BINARY_DIR}/${ADD_TEST_D_INPUT_SOUNDING}")
+    endif()
+
