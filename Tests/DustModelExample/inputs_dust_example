# The example dust model (ERF_DustModelExample.cpp) on a small dry, neutral,
# periodic box with an 8 m/s wind and walls at the top and bottom: a constant
# dust flux leaves the ground everywhere. It checks the out-of-tree model
# plumbing, not dust physics: the registry, the dust sources, the calls after
# each step, the dust in the ERF plotfile and sums, and the checkpoint/restart.
# Nothing leaves the domain, so RHO DUST equals the mass the model emitted.

max_step  = 8
stop_time = 1.0e9

geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 2000.0 2000.0 600.0
geometry.is_periodic = 1 1 0
amr.n_cell           = 20 20 30
amr.max_level        = 0
amr.max_grid_size    = 10 10 30
amr.blocking_factor  = 2

zlo.type = "SlipWall"
zhi.type = "SlipWall"

erf.molec_diff_type = "ConstantAlpha"
erf.dynamic_viscosity = 0.0
erf.rho0_trans        = 1.0
erf.alpha_T           = 0.0
erf.alpha_C           = 10.0
erf.les_type        = "None"
erf.use_gravity     = true
erf.use_coriolis    = false
erf.transport_scalar = true

erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type       = Ideal

erf.fixed_dt     = 0.5
erf.v            = 1   # the integrated sums (RHO DUST) print only with erf.v > 0
amr.v            = 0
erf.sum_interval = 1

erf.plot_file_1 = plt
erf.plot_int_1  = 4
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta rhoadv_dust
erf.check_file  = chk
erf.check_int   = 4

erf.dust.enable = true

dust.example.flux   = 1.0e-4
dust.example.output = dust_example.csv
