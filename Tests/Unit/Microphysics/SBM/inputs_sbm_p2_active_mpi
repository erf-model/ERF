# One-level production decomposition-independence case.  The manufactured
# state and coordinate-defined carrier face pattern activate the production
# grouped limiter at the max_grid_size=8 FAB/rank boundary.
erf.prob_name = "SBM P2 active limiter MPI"
erf.init_type = Uniform
erf.moisture_model = SBM
erf.sbm_nbins = 4
erf.sbm_moment_mode = 2
erf.sbm_cloud_rain_split = 2
erf.sbm_manufactured_initialization = true
erf.sbm_manufactured_velocity = 0.125
erf.sbm_test_active_limiter = true
erf.sbm_transport_method = GroupedFCT_WENOZ3
erf.sbm_diffusion_coeff = 0.0
erf.sbm_chunk_size = 1
erf.anelastic = 0
erf.use_gravity = false
erf.substepping_type = None
erf.fixed_dt = 5.0e-3
erf.molec_diff_type = None
erf.les_type = None
erf.coupling_type = TwoWay
max_step = 1

amr.max_level = 0
amr.max_grid_size = 8
amr.n_error_buf = 0

amr.n_cell = 16 4 4
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 1 1 1

erf.plot_int_1 = -1
erf.check_int = -1
erf.sum_interval = -1
prob.rho_0 = 1.0
prob.T_0 = 300.0
