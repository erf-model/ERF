# WSM6 Bubble Test - Comparison Reference
# Same setup as WDM6 but with single-moment WSM6

# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 500
stop_time = 1200.0

amrex.fpe_trap_invalid = 0

geometry.is_periodic = 1 1 0
geometry.prob_lo     = 0.  0.  0.
geometry.prob_hi     = 4000. 4000. 4000.
amr.n_cell           = 64 64 64
amr.max_level       = 0

erf.fixed_dt         = 0.5
erf.sum_interval     = 10
erf.v                = 1

erf.check_file      = chk_wsm6_bubble
erf.check_int       = 100

erf.plot_file_1     = plt_wsm6_bubble
erf.plot_int_1      = 50
erf.plot_vars_1     = density x_velocity y_velocity z_velocity pressure theta temp
erf.derive_plot_1   = qv qc qi qr qs qg

erf.dycore_vert_adv_type = Centered_2nd
erf.dryscal_vert_adv_type = Centered_2nd
erf.moistscal_vert_adv_type = Centered_2nd

erf.les_type         = None
erf.molec_diff_type  = None
erf.rho0_trans       = 1.0

prob.T_0      = 300.0
prob.U_0      = 0.0
prob.V_0      = 0.0
prob.W_0      = 0.0

prob.bubble_T_pert = 2.0
prob.bubble_x_c    = 2000.0
prob.bubble_y_c    = 2000.0
prob.bubble_z_c    = 1000.0
prob.bubble_radius = 500.0

# MICROPHYSICS: WSM6 (single-moment reference)
erf.moisture_model = "WSM6"
erf.use_moist_background = true

prob.rh_0 = 0.98

zlo.type = "SlipWall"
zhi.type = "Outflow"

erf.cfl = 0.9
