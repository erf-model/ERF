# WDM6 Bubble Test - Basic Functionality
# Warm rising bubble to test convection and cloud formation

# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 500
stop_time = 1200.0

amrex.fpe_trap_invalid = 0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 1 1 0
geometry.prob_lo     = 0.  0.  0.
geometry.prob_hi     = 4000. 4000. 4000.

amr.n_cell           = 64 64 64

# MOST REFINEMENT
amr.max_level       = 0

# TIME STEP CONTROL
erf.fixed_dt         = 0.5
erf.sum_interval     = 10
erf.v                = 1

# DIAGNOSTICS & I/O
erf.check_file      = chk_wdm6_bubble
erf.check_int       = 100

erf.plot_file_1     = plt_wdm6_bubble
erf.plot_int_1      = 50
erf.plot_vars_1     = density x_velocity y_velocity z_velocity pressure theta temp

# Add WDM6-specific plot variables
erf.derive_plot_1   = qv qc qi qr qs qg nc nr nn

# SOLVER CHOICE
erf.dycore_vert_adv_type = Centered_2nd
erf.dryscal_vert_adv_type = Centered_2nd
erf.moistscal_vert_adv_type = Centered_2nd

erf.les_type         = None
erf.molec_diff_type  = None
erf.rho0_trans       = 1.0

# PROBLEM PARAMETERS (rising bubble)
prob.T_0      = 300.0
prob.U_0      = 0.0
prob.V_0      = 0.0
prob.W_0      = 0.0

prob.bubble_T_pert = 2.0
prob.bubble_x_c    = 2000.0
prob.bubble_y_c    = 2000.0
prob.bubble_z_c    = 1000.0
prob.bubble_radius = 500.0

# MICROPHYSICS: WDM6
erf.moisture_model = "WDM6"
erf.use_moist_background = true

# WDM6 Parameters
wdm6.ccn0 = 100.0e6        # Background CCN concentration (m^-3), maritime
wdm6.hail_opt = 0           # 0 = graupel, 1 = hail

# Initial moisture (just above saturation to trigger clouds)
prob.rh_0 = 0.98

# BOUNDARY CONDITIONS
# Periodic in x,y (set above)
# Slip wall bottom, outflow top
zlo.type = "SlipWall"
zhi.type = "Outflow"

# Numerical
erf.cfl = 0.9
