erf.prob_name = "Scalar Advection/Diffusion"
erf.init_type = Uniform
erf.moisture_model = SBM
erf.sbm_nbins = 4
erf.sbm_cloud_rain_split = 2
erf.sbm_fixture_initial_state = 1.e-6 2.e-6 3.e-6 4.e-6
erf.sbm_budget_check = true
erf.use_gravity = false
erf.fixed_dt = 1.e-4
erf.timestepping_type = RK3_NoSubstepping
erf.molec_diff_type = None
erf.les_type = None
erf.pbl_type = None
erf.sponge_type = None
erf.check_file = sbm_boundary_chk
erf.check_int = -1
erf.plot_int_1 = -1
prob.rho_0 = 1.0
prob.T_0 = 300.0
prob.U_0 = 0.8
prob.V_0 = 0.6
prob.W_0 = 0.0
max_step = 3
stop_time = 1.0
amr.max_level = 0
amr.n_cell = 8 4 4
amr.max_grid_size = 4 4 4
geometry.prob_lo = 0 0 0
geometry.prob_hi = 1 1 1
# Spectral inflow at xlo, outflow at xhi, and walls in z.  A z-periodic domain
# with nonperiodic lateral faces is avoided: with vertical flow there, ERF's
# own dry-air mass is not conserved through the periodic z faces.
geometry.is_periodic = 0 1 0
xlo.type = Inflow
xlo.velocity = 0.8 0.6 0.0
xlo.density = 1.0
xlo.theta = 300.0
xlo.sbm_inflow_z = 4.e-6 3.e-6 2.e-6 1.e-6
xhi.type = Outflow
zlo.type = SlipWall
zhi.type = SlipWall
